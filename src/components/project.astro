---
import "../styles/global.css";
---

<section
  id="ProjectPage"
  class="relative flex h-screen w-screen items-center justify-center overflow-hidden bg-white font-sans"
>
  <div
    id="project-stage"
    class="absolute h-[1080px] w-[1920px] origin-center shrink-0"
  >
    <div class="flex flex-col items-center justify-center h-full p-12">
      
      <div class="relative w-[1500px] mb-6 flex flex-col">
        <img
          src="/bannerexample.jpg"
          alt="Project Banner"
          class="w-full h-[180px] object-cover grayscale opacity-80"
        />
        <p class="absolute right-0 -top-7 text-gray-400 font-mono text-sm tracking-widest">
          V.1-Entry&#8968;3/10&#8969;
        </p>
      </div>

      <div class="mx-auto w-[1500px]">
        
        <div class="mb-4 grid grid-cols-[80px_1fr_1fr] gap-4">
          <div></div> 

          <div class="relative">
            <div class="absolute top-1/2 h-[2px] w-full -translate-y-1/2 bg-gray-300"></div>
            <div class="relative inline-block bg-black px-4 py-1 text-2xl font-bold tracking-tighter text-white">
              WEBSITE
            </div>
          </div>

          <div class="relative">
            <div class="absolute top-1/2 h-[2px] w-full -translate-y-1/2 bg-gray-300"></div>
            <div class="relative inline-block bg-black px-4 py-1 text-2xl font-bold tracking-tighter text-white">
              GAME & OTHER
            </div>
          </div>
        </div>

        <div class="grid grid-cols-[80px_1fr_1fr] grid-rows-4 gap-4">
          

          <div class="row-span-2 bg-black text-white flex items-start justify-center pt-3 font-mono text-base font-bold">
            <span class="-rotate-90 mt-6 tracking-widest whitespace-nowrap">2026.08</span>
          </div>

          <div class="group relative h-[130px] bg-gray-100 border border-gray-300 p-3 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-black hover:bg-black hover:text-white cursor-crosshair">
            <div class="relative z-10 flex justify-between items-start">
              <h3 class="text-lg font-bold uppercase tracking-tighter leading-none">Developer Portfolio</h3>
