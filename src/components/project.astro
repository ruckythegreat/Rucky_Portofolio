---

<section
  id="ProjectPage"
  class="relative w-full bg-white font-sans max-lg:pt-0 lg:pt-20"
>
  <!-- ========================================= -->
  <!-- DESKTOP MARQUEE -->
  <!-- ========================================= -->
  <div class="project-marquee hidden overflow-hidden py-10 lg:block lg:py-14">
    <div class="project-marquee-rail flex whitespace-nowrap will-change-transform">
      {
        Array.from({ length: 8 }).map(() => (
          <h4 class="project-marquee-item mr-10 shrink-0 text-[100px] font-black uppercase tracking-tight">
            // RUCKY PORTOFOLIO
          </h4>
        ))
      }
    </div>
  </div>

  <!-- ========================================= -->
  <!-- MOBILE HEADER -->
  <!-- ========================================= -->
  <div class="project-mobile-header border-b border-black pb-4 pl-[80px] pr-4 pt-12 sm:pl-[100px] lg:hidden">
    <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400">
      V.1-Entry &#8968;3/10&#8969;
    </p>
    <h2 class="mt-1 text-3xl font-black uppercase leading-none sm:text-4xl">
      // RUCKY<br />
      PORTOFOLIO
    </h2>
  </div>

  <!-- ========================================= -->
  <!-- PROJECT SECTION -->
  <!-- ========================================= -->
  <div id="project-pin-zone" class="relative">
    
    <!-- ========================================= -->
    <!-- PROJECT BANNER -->
    <!-- ========================================= -->
    <div
      id="project-banner-wrap"
      class="project-banner relative z-40 mx-auto w-full max-w-[1500px] bg-white max-lg:px-0 lg:px-4"
    >
      <img
        id="project-banner-img"
        src="/bannerexample.jpg"
        alt="Project Banner"
        class="h-[80px] w-full object-cover grayscale opacity-80 sm:h-[120px] lg:h-[180px]"
      />
      <p class="absolute -top-5 right-4 hidden font-mono text-xs tracking-widest text-gray-400 lg:block lg:right-0 lg:text-sm">
        V.1-Entry&#8968;4:10&#8969;
      </p>
    </div>

    <!-- ========================================= -->
    <!-- PROJECT BODY -->
    <!-- ========================================= -->
    <div
      id="project-body"
      class="relative mx-auto w-full max-w-[1500px] pb-32 pt-6 max-lg:px-0 lg:px-4 lg:pb-56 lg:pt-8"
    >
      <!-- ========================================= -->
      <!-- DESKTOP PROJECT GRID -->
      <!-- ========================================= -->
      <div id="project-desktop" class="hidden lg:block">
        {
          projectGroups.map((group, gi) => (
            <div class="project-group mb-10" data-group={gi}>
              <!-- Group Header -->
              {gi === 0 && (
                <div class="mb-4 grid grid-cols-[80px_1fr_1fr] gap-4">
                  <div />
                  <div class="relative">
                    <div class="absolute top-1/2 h-[2px] w-full -translate-y-1/2 bg-gray-300" />
                    <div class="relative inline-block bg-black px-4 py-1 text-2xl font-bold tracking-tighter text-white">
                      WEBSITE
                    </div>
                  </div>
                  <div class="relative">
                    <div class="absolute top-1/2 h-[2px] w-full -translate-y-1/2 bg-gray-300" />
                    <div class="relative inline-block bg-black px-4 py-1 text-2xl font-bold tracking-tighter text-white">
                      GAME & OTHER
                    </div>
                  </div>
                </div>
              )}

              <div class="grid grid-cols-[80px_1fr_1fr] gap-4">
                <!-- Date -->
                <div
                  class="flex items-start justify-center bg-black pt-3 text-white"
                  style={`grid-row: span ${Math.ceil(group.projects.length / 2)}`}
                >
                  <span class="mt-6 -rotate-90 whitespace-nowrap font-mono text-base font-bold tracking-widest">
                    {group.date}
                  </span>
                </div>

                {
                  group.projects.map((project, projectIndex) => {
                    const accentColors = ["#ffc994", "#FF7873", "#E22F80", "#8140DC"];
                    const accent = accentColors[projectIndex % accentColors.length];

                    return (
                      <article
                        class="project-card group relative flex h-[130px] cursor-pointer flex-col justify-between overflow-hidden border border-gray-300 bg-gray-100 p-0 transition-colors duration-300 hover:border-black"
                        data-yt={project.ytId}
                        data-deploy={project.deploy}
                        data-source={project.source}
                        data-title={project.title}
                        data-desc={project.desc}
                        data-tags={project.tags.join(",")}
                        data-laptop={project.laptop || ""}
                      >
                        <div class="pointer-events-none absolute bottom-0 left-0 top-0 z-30 w-[3px]" style={`background-color: ${accent};`} />
                        <div class="pointer-events-none absolute left-0 top-0 z-30 h-[14px] w-[14px] border-l-[2px] border-t-[2px]" style={`border-color: ${accent};`} />
                        <div class="pointer-events-none absolute bottom-0 left-0 z-30 h-[2px] w-[35%] transition-all duration-300 group-hover:w-full" style={`background-color: ${accent};`} />

                        <div class="flex h-full w-full">
                          <div class="relative z-10 flex w-[65%] flex-col justify-between p-4 transition-colors duration-300">
                            <div class="flex items-start justify-between">
                              <h3 class="text-lg font-bold uppercase leading-none tracking-tighter transition-colors group-hover:text-white">
                                {project.title}
                              </h3>
                            </div>
                            <div class="max-w-[100%] -translate-x-3 text-xs text-gray-500 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:text-gray-200 group-hover:opacity-100">
                              {project.desc}
                            </div>
                            <div class="mt-auto flex flex-wrap gap-2">
                              {project.tags.map((tag) => (
                                <span class="rounded-full border border-gray-400 px-2 py-0.5 font-mono text-[9px] uppercase transition-colors group-hover:border-white group-hover:text-white">
                                  {tag}
                                </span>
                              ))}
                            </div>
                          </div>

                          <div class="relative z-0 w-[35%] overflow-hidden border-l border-gray-300 bg-black transition-colors group-hover:border-black flex items-center justify-center">
                            {project.ytId ? (
                              <iframe
                                src={`https://www.youtube.com/embed/${project.ytId}?autoplay=1&mute=1&controls=0&showinfo=0&modestbranding=1&rel=0&loop=1&playlist=${project.ytId}&playsinline=1`}
                                class="pointer-events-none absolute left-1/2 top-1/2 h-[200%] w-[200%] -translate-x-1/2 -translate-y-1/2 grayscale transition-all duration-500 group-hover:scale-[1.1] group-hover:grayscale-0 group-hover:opacity-100"
                                allow="autoplay; encrypted-media"
                                loading="lazy"
                                tabindex="-1"
                              />
                            ) : (
                               <div class="text-xs text-zinc-500 font-mono tracking-widest group-hover:text-white transition-colors duration-500">NO PREVIEW</div>
                            )}
                            <div class="absolute inset-0 flex items-center justify-center bg-black/40 text-[#ffffff] opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                              <ArrowBigRightDash size={32} />
                            </div>
                          </div>
                        </div>
                        <div class="pointer-events-none absolute inset-y-0 left-0 z-0 w-[65%] origin-left scale-x-0 bg-black transition-transform duration-300 group-hover:scale-x-100" />
                      </article>
                    );
                  })
                }
                {group.projects.length % 2 !== 0 && <div />}
              </div>
            </div>
          ))
        }
      </div>

      <!-- ========================================= -->
      <!-- MOBILE PROJECT LIST -->
      <!-- ========================================= -->
      <div id="project-mobile" class="space-y-6 pl-[80px] pr-4 sm:pl-[100px] lg:hidden">
        {
          projectGroups.map((group) => (
            <div class="project-mobile-group">
              <div class="mb-3 inline-block bg-black px-3 py-1 font-mono text-xs font-bold tracking-widest text-white">
                {group.date}
              </div>

              <div class="space-y-4">
                {
                  group.projects.map((project, projectIndex) => {
                    const accentColors = ["#ffc994", "#FF7873", "#E22F80", "#8140DC"];
                    const accent = accentColors[projectIndex % accentColors.length];

                    return (
                      <article
                        class="project-card group relative cursor-pointer overflow-hidden rounded-md border border-gray-300 bg-gray-100 transition-colors active:bg-black active:text-white"
                        data-yt={project.ytId}
                        data-deploy={project.deploy}
                        data-source={project.source}
                        data-title={project.title}
                        data-desc={project.desc}
                        data-tags={project.tags.join(",")}
                        data-laptop={project.laptop || ""}
                      >
                        <div class="pointer-events-none absolute bottom-0 left-0 top-0 z-30 w-[3px]" style={`background-color: ${accent};`} />
                        <div class="pointer-events-none absolute left-0 top-0 z-30 h-[14px] w-[14px] border-l-[2px] border-t-[2px]" style={`border-color: ${accent};`} />
                        <div class="pointer-events-none absolute bottom-0 left-0 z-30 h-[2px] w-[40%]" style={`background-color: ${accent};`} />

                        <div class="relative aspect-video w-full flex items-center justify-center overflow-hidden border-b border-gray-300 bg-black transition-colors group-active:border-gray-700">
                          {project.ytId ? (
                             <iframe
                               src={`https://www.youtube.com/embed/${project.ytId}?autoplay=1&mute=1&controls=0&showinfo=0&modestbranding=1&rel=0&loop=1&playlist=${project.ytId}&playsinline=1`}
                               class="pointer-events-none absolute left-1/2 top-1/2 h-[200%] w-[200%] -translate-x-1/2 -translate-y-1/2 grayscale transition-all duration-300 group-active:scale-[1.05] group-active:grayscale-0"
                               allow="autoplay; encrypted-media"
                               loading="lazy"
                               tabindex="-1"
                             />
                          ) : (
                             <div class="text-xs text-zinc-600 font-mono tracking-widest">NO PREVIEW</div>
                          )}
                        </div>

                        <div class="relative z-10 p-4">
                          <div class="flex items-start justify-between gap-3">
                            <h3 class="text-base font-bold uppercase leading-tight tracking-tighter">
                              {project.title}
                            </h3>
                            <ArrowBigRightDash
                              size={20}
                              class="shrink-0 opacity-40 group-active:opacity-100"
                              style={`color: ${accent};`}
                            />
                          </div>
                          <p class="mt-2 text-xs leading-relaxed text-gray-600 group-active:text-gray-300">
                            {project.desc}
                          </p>
                          <div class="mt-4 flex flex-wrap gap-2">
                            {project.tags.map((tag) => (
                              <span class="rounded-full border border-current px-2 py-0.5 font-mono text-[9px] uppercase">
                                {tag}
                              </span>
                            ))}
                          </div>
                        </div>
                      </article>
                    );
                  })
                }
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ========================================= -->
  <!-- HOVER PREVIEW DESKTOP -->
  <!-- ========================================= -->
  <div
    id="project-preview"
    class="pointer-events-none fixed z-[60] hidden w-[340px] flex-col overflow-hidden rounded-lg border border-white/20 bg-black/80 opacity-0 shadow-[0_10px_40px_rgba(0,0,0,0.8)] backdrop-blur-md transition-opacity duration-200 lg:flex"
  >
    <div class="relative aspect-video w-full bg-zinc-900">
      <iframe
        id="project-preview-iframe"
        class="pointer-events-none absolute inset-0 h-full w-full"
        src=""
        title="Project preview"
        allow="autoplay; encrypted-media"
        loading="lazy"
      ></iframe>
      <div class="absolute inset-0 shadow-[inset_0_0_20px_rgba(0,0,0,0.5)]" />
    </div>
    <div class="flex items-center justify-between bg-black/90 p-3 text-xs uppercase tracking-wider text-white">
      <span class="flex items-center gap-2 font-bold">
        <ArrowBigRightDash size={14} class="text-[#FF7873]" />
        Click to Expand
      </span>
    </div>
  </div>

  <!-- ========================================= -->
  <!-- FULL PROJECT MODAL -->
  <!-- ========================================= -->
  <div
    id="project-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 p-4 opacity-0 backdrop-blur-md transition-opacity duration-300 lg:p-10"
  >
    <button
      id="project-modal-close"
      class="absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur-md transition-colors hover:bg-[#FF7873] hover:text-black lg:right-6 lg:top-6 lg:h-12 lg:w-12 lg:bg-white/10"
      aria-label="Close modal"
    >
      <X size={24} />
    </button>

    <div class="relative flex max-h-[95vh] w-full max-w-6xl flex-col overflow-hidden rounded-lg bg-zinc-900 shadow-2xl">
      <!-- Area konten dinamis Modal nantinya dirender oleh JS Client-side -->
      <div id="project-modal-content" class="h-full w-full p-6 text-white overflow-y-auto">
         <!-- Container untuk iframe/video modal dan detail project -->
      </div>
    </div>
  </div>
</section>