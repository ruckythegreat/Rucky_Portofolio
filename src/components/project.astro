            <span class="-rotate-90 mt-6 tracking-widest whitespace-nowrap">2025.07</span>
          </div>

          <div class="group relative h-[130px] bg-gray-100 border border-gray-300 p-3 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-black hover:bg-black hover:text-white cursor-crosshair">
            <div class="relative z-10 flex justify-between items-start">
              <h3 class="text-lg font-bold uppercase tracking-tighter leading-none">Mimi Visual Novel</h3>
              <a href="#" class="opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
                
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-big-right-dash-icon lucide-arrow-big-right-dash"><path d="M11 9a1 1 0 0 0 1-1V4.707a.707.707 0 0 1 1.207-.5l6.94 6.94a1.207 1.207 0 0 1 0 1.707l-6.94 6.94a.707.707 0 0 1-1.207-.5V16a1 1 0 0 0-1-1H9a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1z"/><path d="M4 9v6"/></svg>
              
              </a>
                        </div>
            <div class="relative z-10 opacity-0 -translate-x-3 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out text-xs max-w-[85%] text-gray-400 group-hover:text-gray-300">
              Eksplorasi web app visual novel dengan structured chapter routing.
            </div>
            <div class="relative z-10 flex gap-2 mt-auto">
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">React</span>
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">Vite</span>
            </div>
          </div>

          <div></div>
          <div></div>

          <div class="group relative h-[130px] bg-gray-100 border border-gray-300 p-3 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-black hover:bg-black hover:text-white cursor-crosshair">
            <div class="relative z-10 flex justify-between items-start">
              <h3 class="text-lg font-bold uppercase tracking-tighter leading-none">Structures & Algo</h3>
              <a href="#" class="opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
                
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-big-right-dash-icon lucide-arrow-big-right-dash"><path d="M11 9a1 1 0 0 0 1-1V4.707a.707.707 0 0 1 1.207-.5l6.94 6.94a1.207 1.207 0 0 1 0 1.707l-6.94 6.94a.707.707 0 0 1-1.207-.5V16a1 1 0 0 0-1-1H9a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1z"/><path d="M4 9v6"/></svg>
              
              </a>
                        </div>
            <div class="relative z-10 opacity-0 -translate-x-3 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out text-xs max-w-[85%] text-gray-400 group-hover:text-gray-300">
              Penyelesaian problem trace, rekursi, dan implementasi data stack vector.
            </div>
            <div class="relative z-10 flex gap-2 mt-auto">
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">C++</span>
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">Algorithms</span>
            </div>
          </div>


          
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function autoScaleProjectStage() {
    const stage = document.getElementById("project-stage");
    if (!stage) return;

    const baseWidth = 1920;
    const baseHeight = 1080;

    const scale = Math.min(
      window.innerWidth / baseWidth,
      window.innerHeight / baseHeight
    );

    stage.style.left = "50%";
    stage.style.top = "50%";
    stage.style.transform = `translate(-50%, -50%) scale(${scale})`;
  }

  document.addEventListener("DOMContentLoaded", autoScaleProjectStage);
  window.addEventListener("resize", autoScaleProjectStage);
</script>