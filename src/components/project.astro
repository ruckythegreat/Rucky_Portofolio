---
import "../styles/global.css";
---

<section
  id="ProjectPage"
  class="relative flex h-screen w-screen items-center justify-center overflow-hidden bg-white font-sans"
>
  <div
    id="project-stage"
    class="absolute h-[1080px] w-[1920px] origin-center shrink-0"
  >
    <div class="flex flex-col items-center justify-center h-full p-12">
      
      <!-- Top Banner & Meta -->
      <div class="relative w-[1500px] mb-6 flex flex-col">
        <img
          src="/bannerexample.jpg"
          alt="Project Banner"
          class="w-full h-[180px] object-cover grayscale opacity-80"
        />
        <p class="absolute right-0 -top-7 text-gray-400 font-mono text-sm tracking-widest">
          V.1-Entry&#8968;3/10&#8969;
        </p>
      </div>

      <!-- Main Matrix Grid -->
      <div class="mx-auto w-[1500px]">
        
        <!-- Headers Kategori -->
        <div class="mb-4 grid grid-cols-[80px_1fr_1fr] gap-4">
          <div></div> <!-- Offset kiri -->

          <div class="relative">
            <div class="absolute top-1/2 h-[2px] w-full -translate-y-1/2 bg-gray-300"></div>
            <div class="relative inline-block bg-black px-4 py-1 text-2xl font-bold tracking-tighter text-white">
              WEBSITE
            </div>
          </div>

          <div class="relative">
            <div class="absolute top-1/2 h-[2px] w-full -translate-y-1/2 bg-gray-300"></div>
            <div class="relative inline-block bg-black px-4 py-1 text-2xl font-bold tracking-tighter text-white">
              GAME & OTHER
            </div>
          </div>
        </div>

        <!-- Matrix Content (Tinggi box disesuaikan ke 130px agar pas 1080px) -->
        <div class="grid grid-cols-[80px_1fr_1fr] grid-rows-4 gap-4">
          
          <!-- 2026.08 -->
          <div class="row-span-2 bg-black text-white flex items-start justify-center pt-3 font-mono text-base font-bold">
            <span class="-rotate-90 mt-6 tracking-widest whitespace-nowrap">2026.08</span>
          </div>

          <!-- Proyek 1: Developer Portfolio -->
          <div class="group relative h-[130px] bg-gray-100 border border-gray-300 p-3 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-black hover:bg-black hover:text-white cursor-crosshair">
            <div class="relative z-10 flex justify-between items-start">
              <h3 class="text-lg font-bold uppercase tracking-tighter leading-none">Developer Portfolio</h3>
              <a href="#" class="opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">↗</a>
            </div>
            <div class="relative z-10 opacity-0 -translate-x-3 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out text-xs max-w-[85%] text-gray-400 group-hover:text-gray-300">
              Implementasi ScrollTrigger dengan transisi multi-warna dan struktur interaktif.
            </div>
            <div class="relative z-10 flex gap-2 mt-auto">
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">Astro</span>
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">GSAP</span>
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">Tailwind</span>
            </div>
          </div>

          <div></div>
          <div></div>

          <!-- Proyek 2: Entara -->
          <div class="group relative h-[130px] bg-gray-100 border border-gray-300 p-3 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-black hover:bg-black hover:text-white cursor-crosshair">
            <div class="relative z-10 flex justify-between items-start">
              <h3 class="text-lg font-bold uppercase tracking-tighter leading-none">Entara (Neptara)</h3>
              <a href="#" class="opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">↗</a>
            </div>
            <div class="relative z-10 opacity-0 -translate-x-3 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out text-xs max-w-[85%] text-gray-400 group-hover:text-gray-300">
              Konsep RPG souls-like open-world dengan sistem defleksi postur mekanik.
            </div>
            <div class="relative z-10 flex gap-2 mt-auto">
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">Unity</span>
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">C#</span>
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">Game Design</span>
            </div>
          </div>

          <!-- 2025.07 -->
          <div class="row-span-2 bg-black text-white flex items-start justify-center pt-3 font-mono text-base font-bold">
            <span class="-rotate-90 mt-6 tracking-widest whitespace-nowrap">2025.07</span>
          </div>

          <!-- Proyek 3: Mimi Visual Novel -->
          <div class="group relative h-[130px] bg-gray-100 border border-gray-300 p-3 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-black hover:bg-black hover:text-white cursor-crosshair">
            <div class="relative z-10 flex justify-between items-start">
              <h3 class="text-lg font-bold uppercase tracking-tighter leading-none">Mimi Visual Novel</h3>
              <a href="#" class="opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">↗</a>
            </div>
            <div class="relative z-10 opacity-0 -translate-x-3 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out text-xs max-w-[85%] text-gray-400 group-hover:text-gray-300">
              Eksplorasi web app visual novel dengan structured chapter routing.
            </div>
            <div class="relative z-10 flex gap-2 mt-auto">
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">React</span>
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">Vite</span>
            </div>
          </div>

          <div></div>
          <div></div>

          <!-- Proyek 4: Structures & Algo -->
          <div class="group relative h-[130px] bg-gray-100 border border-gray-300 p-3 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-black hover:bg-black hover:text-white cursor-crosshair">
            <div class="relative z-10 flex justify-between items-start">
              <h3 class="text-lg font-bold uppercase tracking-tighter leading-none">Structures & Algo</h3>
              <a href="#" class="opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">↗</a>
            </div>
            <div class="relative z-10 opacity-0 -translate-x-3 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out text-xs max-w-[85%] text-gray-400 group-hover:text-gray-300">
              Penyelesaian problem trace, rekursi, dan implementasi data stack vector.
            </div>
            <div class="relative z-10 flex gap-2 mt-auto">
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">C++</span>
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 border border-current rounded-full">Algorithms</span>
            </div>
          </div>


          
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function autoScaleProjectStage() {
    const stage = document.getElementById("project-stage");
    if (!stage) return;

    const baseWidth = 1920;
    const baseHeight = 1080;

    const scale = Math.min(
      window.innerWidth / baseWidth,
      window.innerHeight / baseHeight
    );

    stage.style.left = "50%";
    stage.style.top = "50%";
    stage.style.transform = `translate(-50%, -50%) scale(${scale})`;
  }

  document.addEventListener("DOMContentLoaded", autoScaleProjectStage);
  window.addEventListener("resize", autoScaleProjectStage);
</script>