---
import "../styles/global.css";
---
<section class="min-h-screen bg-white py-24">

    <div class="mx-auto flex max-w-[1600px] gap-12">

        <!-- Sidebar -->

        <aside class="flex w-[110px] flex-col items-center bg-yellow-300 py-10">

            <div class="mb-auto text-center">

                <h3 class="text-4xl font-black">
                    CONTACT
                </h3>

            </div>

            <div class="mt-auto">

                <p class="rotate-90 text-4xl font-black whitespace-nowrap">
                    RUCKY
                </p>

            </div>

        </aside>

        <!-- Content -->

        <main class="flex-1">

            <div class="mb-8">

                <p class="text-sm text-gray-500">
                    // Contact
                </p>

                <h1 class="text-6xl font-black">
                    LET'S CONNECT
                </h1>

            </div>

            <div class="mb-10 border-b pb-6">

                <p class="text-2xl">
                    Find me on these platforms.
                </p>

            </div>

            <!-- Cards -->

            <div class="grid grid-cols-3 gap-6">

                <a
                    href="https://discord.com/users/YOUR_ID"
                    target="_blank"
                    class="group overflow-hidden rounded-lg border w-360 p-8 transition hover:-translate-y-2"
                >

                    <h2 class="mb-4 text-4xl font-bold">
                        Discord
                    </h2>

                    <p class="text-gray-500">
                        Chat with me directly.
                    </p>

                </a>

            </div>

        </main>

    </div>

</section>