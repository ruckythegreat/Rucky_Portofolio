---
import "../styles/global.css";
---

<footer class="bg-[#0d0d0d] text-white w-full font-sans border-t border-gray-800">
  
  <!-- === SECTION 1: LANGUAGE SELECTOR === -->
  <div class="flex flex-col items-center justify-center py-10">
    <span class="text-gray-400 text-sm mb-3">Select Language</span>
    
    <!-- Tombol Dropdown Bahasa -->
    <button class="bg-[#f5f5f5] text-black w-64 py-2.5 px-4 flex items-center justify-between hover:bg-gray-300 transition-colors">
      <div class="flex items-center gap-2">
        <!-- Icon Globe SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="font-medium text-sm">English</span>
      </div>
      <!-- Icon Arrow Up SVG -->
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
      </svg>
    </button>
  </div>

  <!-- === DIVIDER LINE === -->
  <div class="w-full h-px bg-[#1f1f1f]"></div>

  <!-- === SECTION 2: MAIN FOOTER CONTENT === -->
  <div class="flex flex-col items-center justify-center py-12 px-4">
    
    <!-- Game Logo Placeholder -->
    <!-- Ganti src ini dengan logo Arknights Endfield milikmu -->
    <img src="/endfield-logo.png" class="h-10 mb-10 object-contain" />

    <!-- Links -->
    <div class="flex items-center gap-6 text-[13px] font-bold tracking-widest mb-10 uppercase">
      <a href="#" class="hover:text-gray-400 transition-colors">Terms of Service</a>
      <span class="text-gray-600">|</span>
      <a href="#" class="hover:text-gray-400 transition-colors">Privacy Policy</a>
      <span class="text-gray-600">|</span>
      <a href="#" class="hover:text-gray-400 transition-colors">Contact Us</a>
    </div>


    <img src="" alt="" class="h-16 mb-8 border border-gray-600" />

    <!-- Legal Text -->
    <p class="text-[10px] text-gray-500 text-center max-w-4xl leading-relaxed mb-8">
      "AUJSKDHIKJSADJHIKASDASD.<br/>
      BABBABABAABBABABABABABABABABABA
    </p>

    <!-- Company Logos -->
    <div class="flex items-center justify-center gap-8 mb-4">
      <img src="" alt="" class="h-5 opacity-60 hover:opacity-100 transition-opacity grayscale" />
      <img src="" alt=" " class="h-6 opacity-60 hover:opacity-100 transition-opacity grayscale" />
    </div>

    <!-- Copyright -->
    <p class="text-[10px] text-gray-600">
      © 2022-2026 Rucky. All rights reserved.
    </p>

  </div>
  
</footer>