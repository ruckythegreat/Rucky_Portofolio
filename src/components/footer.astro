---
import "../styles/global.css";
---

<footer id="site-footer" class="relative bg-[#0d0d0d] text-white w-full font-sans border-t border-gray-800 overflow-hidden">
  <svg
    id="footer-wave"
    class="absolute top-0 left-0 w-full h-16 -translate-y-[99%] text-[#0d0d0d]"
    viewBox="0 0 1440 80"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      id="footer-wave-path"
      fill="currentColor"
      d="M0,40 C320,80 640,0 960,40 C1200,70 1320,20 1440,40 L1440,80 L0,80 Z"
    />
  </svg>

  <div class="flex flex-col items-center justify-center py-10">
    <span class="text-gray-400 text-sm mb-3">Select Language</span>
    

    <button class="bg-[#f5f5f5] text-black w-64 py-2.5 px-4 flex items-center justify-between hover:bg-gray-300 transition-colors">
      <div class="flex items-center gap-2">

        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="font-medium text-sm">English</span>
      </div>

      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
      </svg>
    </button>
  </div>

  <!-- === DIVIDER LINE === -->
  <div class="w-full h-px bg-[#1f1f1f]"></div>

  <!-- === SECTION 2: MAIN FOOTER CONTENT === -->
  <div class="flex flex-col items-center justify-center py-12 px-4">
    <img src="" class="h-10 mb-10 object-contain" />

    <!-- Links -->
    <div class="flex items-center gap-6 text-[13px] font-bold tracking-widest mb-10 uppercase">
      <a href="#" class="hover:text-gray-400 transition-colors">Terms of Service</a>
      <span class="text-gray-600">|</span>
      <a href="#" class="hover:text-gray-400 transition-colors">Privacy Policy</a>
      <span class="text-gray-600">|</span>
      <a href="#" class="hover:text-gray-400 transition-colors">Contact Us</a>
    </div>


    <img src="" alt="" class="h-16 mb-8 border border-gray-600" />

    <!-- Legal Text -->
    <p class="text-[10px] text-gray-500 text-center max-w-4xl leading-relaxed mb-8">
      "AUJSKDHIKJSADJHIKASDASD.<br/>
      BABBABABAABBABABABABABABABABABA
    </p>

    <!-- Company Logos -->
    <div class="flex items-center justify-center gap-8 mb-4">
      <img src="" alt="" class="h-5 opacity-60 hover:opacity-100 transition-opacity grayscale" />
      <img src="" alt=" " class="h-6 opacity-60 hover:opacity-100 transition-opacity grayscale" />
    </div>

    <!-- Copyright -->
    <p class="text-[10px] text-gray-600">
      © 2022-2026 Rucky. All rights reserved.
    </p>

  </div>
  
</footer>

<script>
  import { gsap, ScrollTrigger } from "../Script/gsap-utils";

  function initFooterWave() {
    const footer = document.getElementById("site-footer");
    const wave = document.getElementById("footer-wave-path");
    if (!footer || !wave) return;

    ScrollTrigger.create({
      trigger: footer,
      start: "top bottom",
      onEnter: (self) => {
        const velocity = Math.abs(self.getVelocity());
        const amp = 1 + Math.min(velocity / 8000, 0.6);
        gsap.fromTo(
          wave,
          { attr: { d: "M0,64 C360,64 720,64 1080,64 C1260,64 1380,64 1440,64 L1440,80 L0,80 Z" } },
          {
            attr: { d: "M0,40 C320,80 640,0 960,40 C1200,70 1320,20 1440,40 L1440,80 L0,80 Z" },
            duration: 1.6,
            ease: `elastic.out(${amp}, 0.45)`,
            overwrite: true,
          }
        );
      },
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFooterWave);
  } else {
    initFooterWave();
  }
</script>