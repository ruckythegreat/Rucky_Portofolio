  { category: "TikTok", date: "2024-12-06", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "rhF1J5NAyvw", originalUrl: "https://www.tiktok.com/@naptuneeel/video/7445337305654562066" },
