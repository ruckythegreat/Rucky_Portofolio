---
import "../styles/global.css";
import BlueprintDecor from "./BlueprintDecor.astro";

// Dummy data untuk foto gallery
const photoList = [
  {
    src: "/IMG_20251116_174551.jpg",
    date: "16 Nov 2025",
    desc: "Suasana sore di lorong sekolah PPLG.",
  },
  {
    src: "/IMG_20251126_150705.jpg",
    date: "26 Nov 2025",
    desc: "Kegiatan praktek di lab komputer.",
  },
  {
    src: "/MVIMG_20251116_175345.jpg",
    date: "16 Nov 2025",
    desc: "Diskusi kelompok persiapan project akhir.",
  },
  {
    src: "/MVIMG_20251116_175407.jpg",
    date: "16 Nov 2025",
    desc: "Presentasi materi dasar-dasar pemrograman.",
  },
  {
    src: "/MVIMG_20251116_175707.jpg",
    date: "16 Nov 2025",
    desc: "Waktu istirahat di lapangan basket.",
  },
  {
    src: "/MVIMG_20251116_175758.jpg",
    date: "16 Nov 2025",
    desc: "Pertandingan persahabatan futsal antar kelas.",
  },
  {
    src: "/MVIMG_20251129_160416.jpg",
    date: "29 Nov 2025",
    desc: "Kegiatan ekstrakurikuler sore hari.",
  },
  {
    src: "/MVIMG_20251201_175042.jpg",
    date: "01 Des 2025",
    desc: "Persiapan pameran karya siswa.",
  },
  {
    src: "/MVIMG_20251204_180110.jpg",
    date: "04 Des 2025",
    desc: "Foto bersama setelah ujian selesai.",
  },
];
---
<main class="relative w-full bg-black overflow-x-hidden font-['HarmonyOS_Sans',_sans-serif]">
{
    /* =========================================================================
      BAGIAN 1: MEDIA VIDEO (HERO SCREEN)
      ========================================================================= */
  }
  <section
    id="MediaPage"
    class="section-breathe relative flex min-h-screen w-screen items-center justify-center overflow-hidden bg-black"
  >
    <BlueprintDecor intensity="subtle" />
    <style>
      @media (max-width: 1023px) {
        #media-stage {
          transform: none !important;
          width: 100% !important;
          height: 100% !important;
          position: relative !important;
          top: 0 !important;
          left: 0 !important;
        }
      }
      .box-content img { transition: transform 0.4s ease-out; }
      .box:hover .box-content img { transform: scale(1.08); }
    </style>
<div id="media-stage" class="absolute z-10 h-[1080px] w-[1920px] shrink-0 origin-center">
      {/* PERBAIKAN: Menggunakan h-full agar elemen 'bottom' tidak terlempar ke luar layar di desktop */}
      <div class="relative flex h-full w-full flex-col justify-center gap-8 px-6 py-20 lg:block lg:p-0 lg:pl-[100px]">
        
        {/* JUDUL: MEDIA VIDEO */}
        <div class="relative z-20 mt-4 lg:absolute lg:left-[100px] lg:top-[80px] lg:mt-0">
          <div class="flex items-center space-x-3">
            <div class="flex h-6 w-6 items-center justify-center border-[2px] border-white lg:h-8 lg:w-8 lg:border-[3px]">
              <div class="h-2.5 w-2.5 bg-white lg:h-3.5 lg:w-3.5"></div>
            </div>
            <h2 class="text-2xl font-bold uppercase tracking-[0.2em] text-white lg:text-[2rem]">
              MEDIA VIDEO
            </h2>
          </div>
        </div>

        {/* BACKGROUND */}
        <div class="pointer-events-none absolute left-0 top-0 z-0 h-full w-full overflow-hidden">
          <div
            id="main-bg-wrap"
            class="absolute inset-0 scale-[1.05] bg-cover bg-center bg-no-repeat opacity-80 transition-all duration-500"
          >
            <iframe
              id="main-bg"
              class="pointer-events-none absolute left-1/2 top-1/2 h-[100vh] w-[177.77vh] min-h-[56.25vw] min-w-[100vw] max-w-none -translate-x-1/2 -translate-y-1/2 lg:left-0 lg:top-0 lg:h-full lg:min-h-0 lg:w-full lg:min-w-0 lg:translate-x-0 lg:translate-y-0"
              src=""
              title="Background preview"
              allow="autoplay; encrypted-media"
              frameborder="0"></iframe>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-transparent lg:bg-gradient-to-r lg:from-black lg:via-black/60 lg:to-transparent"></div>
          <div class="absolute inset-0 hidden bg-gradient-to-t from-black/80 via-transparent to-transparent lg:block"></div>
        </div>

        {/* MEDIA CONTROLS & THUMBNAILS */}
        <div class="relative z-20 flex w-full items-center justify-center lg:absolute lg:bottom-[60px] lg:right-[60px] lg:block lg:w-auto">
          <div class="relative flex w-full items-center justify-center gap-4 lg:w-auto lg:gap-6">
            
            {/* CARD PREV */}
            <div class="group relative hidden h-[124px] w-[220px] shrink-0 cursor-pointer overflow-hidden lg:block" id="card-prev">
              <img id="thumb-prev" src="" alt="" class="media-thumb h-full w-full object-cover opacity-40 transition-opacity duration-300 group-hover:opacity-100" />
              <div class="absolute inset-0 bg-black/60 transition-colors duration-300 group-hover:bg-black/20"></div>
              <div class="pointer-events-none absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0) 35%, rgba(0,0,0,0.75) 100%);"></div>
              <div class="absolute bottom-3 right-3 z-10 flex items-center gap-2 text-[11px] font-bold tracking-widest text-white">
                <span id="prev-counter">00 / 000</span>
                <span class="border border-[var(--color-2)]/60 px-1.5 py-0.5 text-[var(--color-2)]">LAST</span>
              </div>
            </div>

            {/* BTN PREV */}
            <button type="button" class="btn-prev relative z-30 flex h-10 w-10 shrink-0 items-center justify-center bg-white text-black shadow-[0_4px_14px_rgba(0,0,0,0.5)] transition-transform hover:scale-110 hover:bg-gray-200 lg:absolute lg:left-[208px] lg:h-12 lg:w-12">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lg:h-6 lg:w-6"><path d="m15 18-6-6 6-6"></path></svg>
            </button>

            {/* CARD CURR (PLAYING) */}
            <div class="relative z-20 aspect-video w-full max-w-[280px] shrink cursor-pointer overflow-hidden bg-black/50 shadow-[0_10px_30px_rgba(0,0,0,0.6)] lg:h-[190px] lg:w-[340px] lg:max-w-none lg:shrink-0" id="card-curr">
              <img id="thumb-curr" src="" alt="" class="media-thumb h-full w-full object-cover" />
              <div class="absolute left-2 top-2 z-10 rounded bg-black/80 px-2 py-1 text-[10px] font-bold tracking-widest text-white backdrop-blur-sm lg:left-3 lg:top-3 lg:px-3 lg:py-1.5 lg:text-xs">
                PLAYING
              </div>
              <div class="pointer-events-none absolute inset-0 z-10" style="background: linear-gradient(to bottom, rgba(255,230,0,0) 50%, var(--color-2) 100%);"></div>
              <div class="absolute inset-0 z-20 flex items-center justify-center bg-black/30 opacity-100 transition-opacity duration-300 hover:opacity-100 lg:opacity-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="white" class="drop-shadow-lg lg:h-[56px] lg:w-[56px]"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
              </div>
            </div>

            {/* BTN NEXT */}
            <button type="button" class="btn-next relative z-30 flex h-10 w-10 shrink-0 items-center justify-center bg-white text-black shadow-[0_4px_14px_rgba(0,0,0,0.5)] transition-transform hover:scale-110 hover:bg-gray-200 lg:absolute lg:right-[208px] lg:h-12 lg:w-12">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lg:h-6 lg:w-6"><path d="m9 18 6-6-6-6"></path></svg>
            </button>

            {/* CARD NEXT */}
            <div class="group relative hidden h-[124px] w-[220px] shrink-0 cursor-pointer overflow-hidden lg:block" id="card-next">
              <img id="thumb-next" src="" alt="" class="media-thumb h-full w-full object-cover opacity-40 transition-opacity duration-300 group-hover:opacity-100" />
              <div class="absolute inset-0 bg-black/60 transition-colors duration-300 group-hover:bg-black/20"></div>
              <div class="pointer-events-none absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0) 35%, rgba(0,0,0,0.75) 100%);"></div>
              <div class="absolute bottom-3 left-3 z-10 flex items-center gap-2 text-[11px] font-bold tracking-widest text-white">
                <span class="border border-[var(--color-2)]/60 px-1.5 py-0.5 text-[var(--color-2)]">NEXT</span>
                <span id="next-counter">00 / 000</span>
              </div>
            </div>
          </div>
        </div>

        {/* TEKS & KONTEN BAWAH */}
        <div class="relative z-10 flex w-full max-w-2xl flex-col items-start text-white lg:absolute lg:bottom-[100px] lg:left-[100px] lg:pb-0">
          <div class="mb-2 flex items-center space-x-3 lg:mb-4">
            <span id="media-category" class="bg-white/20 px-2 py-1 text-[10px] font-bold uppercase tracking-widest lg:px-3 lg:text-sm">
              CATEGORY
            </span>
            <p id="media-date" class="text-sm font-bold tracking-[0.15em] lg:text-lg" style="color:var(--color-2)">
              2026-00-00
            </p>
          </div>

          <h1 id="media-title" class="my-2 text-3xl font-extrabold leading-[1.1] lg:my-4 lg:text-6xl">
            JUDUL MEDIA
          </h1>

          <p id="media-desc" class="mb-8 line-clamp-3 max-w-xl text-sm leading-relaxed text-gray-300 lg:mb-12 lg:line-clamp-none lg:text-xl">
            (DESKRIPSI MEDIA)
          </p>

          <div class="flex w-full space-x-3 lg:w-auto lg:space-x-4">
            <button id="btn-play" type="button" class="eng-hover group flex h-12 w-16 shrink-0 items-center justify-center bg-[var(--color-2)] text-xs font-bold uppercase tracking-widest text-black shadow-[0_0_20px_rgba(255,120,115,0.35)] lg:h-14 lg:w-20" data-hover-default="PLAY" data-hover-alt="▶ RUN" aria-label="Play video"></button>
            <a href="/videos" class="eng-hover flex h-12 flex-1 items-center justify-center border border-white/30 bg-white/10 px-4 text-sm font-semibold uppercase tracking-widest text-white lg:h-14 lg:flex-none lg:px-8 lg:text-base" data-hover-default="More Videos" data-hover-alt="Open Archive"></a>
          </div>
        </div>

        {/* DEKORASI LINE */}
        <div class="absolute bottom-[160px] left-0 z-10 hidden h-[2px] w-[55%] bg-[var(--color-2)] shadow-[0_0_10px_rgba(255,120,115,0.4)] lg:block"></div>
        <div class="absolute bottom-[160px] left-[55%] z-10 hidden h-[1px] w-[45%] bg-white/20 lg:block"></div>
        <p class="absolute bottom-14 left-[100px] z-10 mt-6 hidden font-medium tracking-wide text-gray-400 lg:block">
          V.1-Entry &#8968; <span id="media-counter" class="font-bold text-white">1</span> / 10 &#8969;
        </p>
      </div>
    </div>
  </section>

  {
    /* =========================================================================
      BAGIAN 2: MEDIA PHOTO (GALLERY GRID)
      ========================================================================= */
  }
  <section id="PhotoPage" class="relative z-20 w-full bg-black py-24 lg:py-40 border-t border-white/10 overflow-hidden">
    <BlueprintDecor intensity="subtle" />
    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-24">
      <div class="mb-14 flex items-center space-x-3">
        <div class="flex h-6 w-6 items-center justify-center border-[2px] border-white lg:h-8 lg:w-8 lg:border-[3px]">
          <div class="h-2.5 w-2.5 bg-white lg:h-3.5 lg:w-3.5"></div>
        </div>
        <h2 class="text-2xl font-bold uppercase tracking-[0.2em] text-white lg:text-[2rem]">
          MEDIA PHOTO
        </h2>
      </div>

      {/* BOXES CONTAINER (Grid Layout) */}
      <div class="boxes-container grid grid-cols-2 gap-5 lg:grid-cols-3 lg:gap-8">
        {photoList.map((photo, index) => (
          <div class={`box group aspect-[4/3] ${index >= 6 ? "hidden-box hidden" : ""}`}>
            <div class="box-content relative h-full w-full flex items-center justify-center cursor-pointer overflow-hidden rounded-md bg-white/5">
              <img src={photo.src} alt={photo.desc} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"/>
              
              <div class="pointer-events-none absolute inset-0 z-10 flex flex-col justify-end bg-gradient-to-t from-black/90 via-black/40 to-transparent p-4 lg:p-6 opacity-0 transition-all duration-300 ease-out group-hover:opacity-100">
                <div class="translate-y-4 transition-transform duration-300 group-hover:translate-y-0">
                  <p class="mb-1 text-[10px] font-bold uppercase tracking-widest text-[var(--color-2)] lg:text-xs">{photo.date}</p>
                  <p class="line-clamp-2 text-xs font-medium leading-relaxed text-white lg:text-sm">{photo.desc}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* TOMBOL SELENGKAPNYA */}
      {photoList.length > 6 && (
        <div class="mt-16 flex justify-center">
          <button id="btn-more-photos" class="eng-hover border border-white/30 bg-white/10 px-10 py-3.5 text-sm font-semibold tracking-widest text-white uppercase" data-hover-default="Selengkapnya" data-hover-alt="Load All"></button>
        </div>
      )}
    </div>
  </section>

  {
    /* =========================================================================
      MODALS
      ========================================================================= */
  }

  {/* Modal Video (Bawaan) - Ditambahkan pembungkus ID 'modal-wrapper' untuk ukuran dinamis */}
  <div id="video-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-sm">
    <button id="video-modal-close" type="button" aria-label="Close video" class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center bg-white/10 text-white hover:bg-white/20 lg:right-6 lg:top-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
    </button>
    <div id="modal-wrapper" class="w-full max-w-5xl px-4 aspect-video transition-all duration-300">
      <iframe id="video-modal-iframe" class="h-full w-full rounded-lg shadow-2xl bg-[#111]" src="" title="Video player" allow="autoplay; encrypted-media; fullscreen" allowfullscreen frameborder="0"></iframe>
    </div>
  </div>

  {/* Modal Foto (GSAP Flip) */}
  <div id="photo-modal" class="fixed inset-0 z-[100] hidden items-center justify-center">
    <div class="overlay absolute inset-0 bg-black/90 backdrop-blur-sm invisible opacity-0"></div>
    <button id="photo-modal-close" type="button" aria-label="Close photo" class="absolute right-4 top-4 z-30 flex h-11 w-11 items-center justify-center bg-white/10 text-white hover:bg-white/20 lg:right-6 lg:top-6 invisible opacity-0">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
    </button>
    <div class="content relative z-20 flex w-full max-w-5xl items-center justify-center p-4"></div>
  </div>
</main>
<script>
  import { initSimpleStageScale, gsap, initEngineHover } from "../Script/gsap-utils";
  import { Flip } from "gsap/Flip";

  function initMediaPage() {
    gsap.registerPlugin(Flip);
    initSimpleStageScale("media-stage");
    initEngineHover(document.querySelector("main") || document);

    // ==========================================
    // DATA CAROUSEL MEDIA 
    // (mediaId sekarang adalah ID YouTube untuk SEMUA item.
    // originalUrl digunakan untuk redirect tombol Play)
    // ==========================================
const mediaList = [
  { category: "Ucapan", date: "2026-08-25", title: "Happy Birthday SMKN 2 Bandung from RPL (Minecraft Edition)", desc: "Ucapan Ulang tahun dan juga open house SMKN 2 dari RPL", type: "youtube", mediaId: "WAAEZzLE-nQ", originalUrl: "https://youtu.be/WAAEZzLE-nQ" },
