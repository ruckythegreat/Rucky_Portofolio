  { category: "TikTok", date: "2023-04-23", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "WM5h0HeSmjY", originalUrl: "https://www.tiktok.com/@naptuneeel/video/7225138172865383686" },
  { category: "TikTok", date: "2023-04-20", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "dLlrXXEzaqQ", originalUrl: "https://www.tiktok.com/@naptuneeel/video/7224151841850821894" },
  
  { category: "TikTok", date: "2023-04-17", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "fFT-lFR1PRs", originalUrl: "https://www.tiktok.com/@naptuneeel/video/7222886262053539099" },
  { category: "TikTok", date: "2023-04-13", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "Bvvxv5RLLVI", originalUrl: "https://www.tiktok.com/@naptuneeel/video/7221315111653231899" }, // DIPERBAIKI SESUAI TEMUAN
  { category: "TikTok", date: "2023-04-10", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "sTYlKYxhcAU", originalUrl: "https://www.tiktok.com/@naptuneeel/video/7220386671345274139" } // PERHATIAN: ID ini duplikat dengan 2024-12-13
];

    mediaList.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

    let currentIndex = 0;
    let switching = false;
    let isFirstLoad = true;

    // Thumbnail untuk "Next/Prev" Card, semua disamakan mengambil thumbnail HD YouTube
    const getThumbnail = (media: any) => {
      return `https://img.youtube.com/vi/${media.mediaId}/maxresdefault.jpg`;
    };

    // Fungsi embed background (Hanya YouTube)
    const getBgEmbed = (media: any) => {
      return `https://www.youtube.com/embed/${media.mediaId}?autoplay=1&mute=1&loop=1&playlist=${media.mediaId}&controls=0&modestbranding=1&rel=0&showinfo=0&iv_load_policy=3`;
    };

    function setMediaContent(currentData: any, prevData: any, nextData: any) {
      if (mediaList.length === 0) return;

      const total = mediaList.length;
      const prevIndex = currentIndex === 0 ? total - 1 : currentIndex - 1;
      const nextIndex = currentIndex === total - 1 ? 0 : currentIndex + 1;

      document.getElementById("media-category")!.textContent = currentData.category;
      document.getElementById("media-date")!.textContent = currentData.date;
      document.getElementById("media-title")!.textContent = currentData.title;
      document.getElementById("media-desc")!.textContent = currentData.desc;
      document.getElementById("media-counter")!.textContent = (currentIndex + 1).toString();

      // Set Background Iframe (Kini selalu aktif karena SEMUA media memiliki ID YouTube)
      const bgWrap = document.getElementById("main-bg-wrap")!;
      const bgIframe = document.getElementById("main-bg") as HTMLIFrameElement;
      
      bgIframe.style.display = "block";
      bgIframe.src = getBgEmbed(currentData);
      bgWrap.style.backgroundImage = "none";
      bgWrap.style.filter = "none";

      (document.getElementById("thumb-prev") as HTMLImageElement).src = getThumbnail(prevData);
      (document.getElementById("thumb-curr") as HTMLImageElement).src = getThumbnail(currentData);
      (document.getElementById("thumb-next") as HTMLImageElement).src = getThumbnail(nextData);

      document.getElementById("prev-counter")!.textContent = `${String(prevIndex + 1).padStart(2, "0")} / ${String(total).padStart(3, "0")}`;
      document.getElementById("next-counter")!.textContent = `${String(nextIndex + 1).padStart(2, "0")} / ${String(total).padStart(3, "0")}`;
    }

    function updateMediaUI(direction = 1) {
      if (switching || mediaList.length === 0) return;

      const prevIndex = currentIndex === 0 ? mediaList.length - 1 : currentIndex - 1;
      const nextIndex = currentIndex === mediaList.length - 1 ? 0 : currentIndex + 1;

      const currentData = mediaList[currentIndex];
      const prevData = mediaList[prevIndex];
      const nextData = mediaList[nextIndex];

      if (isFirstLoad) {
        setMediaContent(currentData, prevData, nextData);
        isFirstLoad = false;
        return;
      }

      switching = true;
      const slideX = direction >= 0 ? 40 : -40;
      const tl = gsap.timeline({
        onComplete: () => { switching = false; }
      });

      tl.to(["#media-title", "#media-desc", "#media-category", "#media-date"], { opacity: 0, y: -12, duration: 0.2, ease: "power2.in" })
        .to("#main-bg-wrap", { opacity: 0.1, duration: 0.2 }, 0)
        .to(["#thumb-prev", "#thumb-curr", "#thumb-next"], { opacity: 0, x: slideX, duration: 0.22, stagger: 0.04, ease: "power2.in" }, 0)
        .call(() => {
          setMediaContent(currentData, prevData, nextData);
          gsap.set(["#thumb-prev", "#thumb-curr", "#thumb-next"], { x: -slideX });
        })
        .to(["#media-title", "#media-desc", "#media-category", "#media-date"], { opacity: 1, y: 0, duration: 0.35, stagger: 0.04, ease: "power2.out" })
        .to("#main-bg-wrap", { opacity: 0.8, duration: 0.4, ease: "power2.out" }, "-=0.25")
        .to(["#thumb-prev", "#thumb-curr", "#thumb-next"], { opacity: (i) => (i === 1 ? 1 : 0.5), x: 0, duration: 0.35, stagger: 0.05, ease: "power3.out" }, "-=0.3");
    }

    const goPrev = () => { currentIndex = currentIndex === 0 ? mediaList.length - 1 : currentIndex - 1; updateMediaUI(-1); };
    const goNext = () => { currentIndex = currentIndex === mediaList.length - 1 ? 0 : currentIndex + 1; updateMediaUI(1); };


    // ==========================================
    // LOGIKA PLAY VIDEO (REDIRECT TAB BARU)
    // Menggantikan modal iframe
    // ==========================================
    function openOriginalVideo() {
      if (mediaList.length === 0) return;
      const data = mediaList[currentIndex];
      // Membuka originalUrl (TikTok/IG/YouTube utama) di tab baru
      window.open(data.originalUrl, "_blank");
    }

    // Assign event listener (Hapus logic lama untuk openVideoModal)
    document.getElementById("btn-play")?.addEventListener("click", openOriginalVideo);
    document.getElementById("card-curr")?.addEventListener("click", openOriginalVideo);


    // ==========================================
    // NAVIGASI CAROUSEL LISTENER
    // ==========================================
    document.querySelectorAll(".btn-prev").forEach((btn) => btn.addEventListener("click", goPrev));
    document.querySelectorAll(".btn-next").forEach((btn) => btn.addEventListener("click", goNext));
    document.getElementById("card-prev")?.addEventListener("click", goPrev);
    document.getElementById("card-next")?.addEventListener("click", goNext);

    updateMediaUI(0);

    // ==========================================
    // LOGIKA MEDIA PHOTO GSAP FLIP
    // ==========================================
    const photoModal = document.getElementById("photo-modal");
    const photoModalContent = photoModal?.querySelector(".content");
    const photoModalOverlay = photoModal?.querySelector(".overlay");
    const photoModalClose = document.getElementById("photo-modal-close");
    const boxes = gsap.utils.toArray(".boxes-container .box");
    const boxesContent = gsap.utils.toArray(".box-content");
    let boxIndex = undefined;

    boxesContent.forEach((box: any, i) => {
      box.addEventListener("click", () => {
        if (boxIndex !== undefined) return;
        const img = box.querySelector("img");
        const state = Flip.getState([box, img]);

        photoModalContent.appendChild(box);
        boxIndex = i;

        box.classList.remove("h-full", "w-full", "rounded-md");
        box.classList.add("w-[90vw]", "h-[85vh]", "rounded-none");
        img.classList.remove("object-cover", "hover:scale-110");
        img.classList.add("object-contain"); 

        gsap.set(photoModal, { display: "flex" });
        gsap.to(photoModalOverlay, { autoAlpha: 0.85, duration: 0.35 });
        gsap.to(photoModalClose, { autoAlpha: 1, duration: 0.35, delay: 0.2 });

        Flip.from(state, { duration: 0.7, ease: "power2.inOut", absolute: true, nested: true, onComplete: () => gsap.set(box, { clearProps: "zIndex" }) });
        gsap.set(box, { zIndex: 1002 });
        document.body.style.overflow = "hidden";
      });
    });

    const closePhotoModal = () => {
      if (boxIndex === undefined) return;
      const box = boxesContent[boxIndex] as HTMLElement;
      const img = box.querySelector("img") as HTMLImageElement;
      const state = Flip.getState([box, img]);

      (boxes[boxIndex] as HTMLElement).appendChild(box);

      box.classList.remove("w-[90vw]", "h-[85vh]", "rounded-none");
      box.classList.add("h-full", "w-full", "rounded-md");
      img.classList.remove("object-contain");
      img.classList.add("object-cover", "hover:scale-110");

      gsap.to([photoModalOverlay, photoModalClose], {
        autoAlpha: 0, ease: "power1.inOut", duration: 0.35,
        onComplete: () => { gsap.set(photoModal, { display: "none" }); boxIndex = undefined; document.body.style.overflow = ""; }
      });
      gsap.set(box, { zIndex: 50 });
      Flip.from(state, { duration: 0.7, ease: "power2.inOut", absolute: true, nested: true, onComplete: () => { gsap.set(box, { clearProps: "zIndex" }); } });
    };

    photoModalOverlay?.addEventListener("click", closePhotoModal);
    photoModalClose?.addEventListener("click", closePhotoModal);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (boxIndex !== undefined) closePhotoModal();
      }
    });

    // ==========================================
    // LOGIKA TOMBOL SELENGKAPNYA (PHOTOS)
    // ==========================================
    const btnMorePhotos = document.getElementById("btn-more-photos");
    const hiddenBoxes = document.querySelectorAll(".hidden-box");
    if (btnMorePhotos) {
      btnMorePhotos.addEventListener("click", () => {
        hiddenBoxes.forEach((box) => {
          box.classList.remove("hidden");
          gsap.fromTo(box, { autoAlpha: 0, y: 30 }, { autoAlpha: 1, y: 0, duration: 0.6, ease: "power2.out" });
        });
        btnMorePhotos.style.display = "none";
      });
    }
  }

  if (document.readyState === "loading") { document.addEventListener("DOMContentLoaded", initMediaPage); } 
  else { initMediaPage(); }
</script>