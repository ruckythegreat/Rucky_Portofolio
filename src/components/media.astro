  { category: "Instagram", date: "2024-12-16", title: "Instagram Post @naptuneeel", desc: "Postingan media Instagram dari akun @naptuneeel", type: "instagram", mediaId: "SM7ux-EIkMI", originalUrl: "https://www.instagram.com/p/DDq9QJjvaq_u7QgafFQUSa2fCT5ZBrwe9z5EaE0/" },
  { category: "TikTok", date: "2024-12-13", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "XZv6V-Ri460", originalUrl: "https://www.tiktok.com/@naptuneeel/video/7447688845388270866" }, // PERHATIAN: ID ini duplikat dengan 2023-04-10
