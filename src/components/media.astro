---
import "../styles/global.css";
---

<div class="w-screen h-[300px] bg-black"></div>

<section
  id="MediaPage"
  class="relative w-screen h-screen overflow-hidden flex items-center justify-center bg-black"
>



  <div
    id="media-stage"
    class="absolute w-[1920px] h-[1080px] origin-center shrink-0"
  >
    <div class="relative h-full pl-20">
      <div class="flex flex-col items-start h-full">
        
        <!-- Header Kiri Atas -->
        <div class="absolute top-20 left-20 z-10">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 border-2 border-white flex items-center justify-center">
              <div class="w-4 h-4 bg-white"></div>
            </div>
            <h2 class="text-4xl text-white font-bold tracking-widest uppercase">
              MEDIA
            </h2>
          </div>
        </div>

        <!-- Background Layar Penuh -->
        <div class="absolute top-0 left-0 z-[-100] h-screen w-full">
          <img 
            id="main-bg" 
            src="" 
            alt="Background" 
            class="w-full h-full object-cover opacity-60 blur-md transition-all duration-500 scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
        </div>

        <!-- Konten Utama Kiri -->
        <div class="absolute top-[40%] left-20 right-300 flex flex-col items-start text-white w-1/2">
          <div class="flex items-center space-x-4 mb-2">
            <span id="media-category" class="bg-white/20 px-3 py-1 rounded text-sm font-semibold tracking-wider">CATEGORY</span>
            <p id="media-date" class="font-bold tracking-widest text-lg" style=" color:#FF7873

            ">
              2026-00-00
            </p>
          </div>

          <h1 id="media-title" class="text-5xl font-bold my-4 leading-tight transition-opacity duration-300">
            JUDUL MEDIA
          </h1>

          <p id="media-desc" class="text-lg text-gray-300 mb-8 max-w-2xl transition-opacity duration-300">
            (DESKRIPSI MEDIA)
          </p>

          <div class="flex space-x-4">
            <button class="bg-[#FF7873] hover:bg-[#FF7873] text-black font-bold flex items-center justify-center w-16 h-12 rounded transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play"><polygon points="6 3 20 12 6 21 6 3"/></svg>
            </button>
            <button class="bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold px-6 h-12 flex items-center rounded transition-colors backdrop-blur-sm">
              More Videos
            </button>
          </div>
        </div>

        <p class="absolute bottom-20 left-20 mt-6 text-gray-400">
          V.1-Entry&#8968;<span id="media-counter">3</span>/10&#8969;
        </p>

        <!-- Garis Aksen Kuning -->
        <div class="absolute bottom-[350px] left-0 w-[60%] h-1 bg-[#FF7873] z-10"></div>
        <div class="absolute bottom-[350px] left-[60%] w-[40%] h-[1px] bg-white/30 z-10"></div>

        <!-- Carousel Kanan Bawah -->
        <div class="absolute bottom-10 right-10 z-20">
          <div class="flex items-end space-x-4">
            
            <!-- Thumbnail Kiri (Previous) -->
            <div class="relative w-[240px] h-[135px] group cursor-pointer" id="card-prev">
              <img id="thumb-prev" src="" alt="" class="w-full h-full object-cover opacity-50 group-hover:opacity-80 transition-opacity" />
              <div class="absolute inset-0 bg-black/50"></div>
            </div>

            <!-- Tombol Navigasi Kiri (Menggunakan class, bukan id ganda) -->
            <button type="button" class="btn-prev bg-white hover:bg-gray-200 text-black w-10 h-10 rounded-full flex items-center justify-center absolute left-[210px] bottom-[50px] z-30 transition-transform hover:scale-110 shadow-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>

            <!-- Thumbnail Tengah (Active) -->
            <div class="relative w-[340px] h-[190px] border-4 border-[#FF7873] shadow-2xl scale-105 z-20">
              <img id="thumb-curr" src="" alt="" class="w-full h-full object-cover" />
              <div class="absolute top-2 left-2 bg-black/60 px-2 py-1 text-xs text-white">PLAYING</div>
            </div>

            <!-- Tombol Navigasi Kanan (Menggunakan class, bukan id ganda) -->
            <button type="button" class="btn-next bg-white hover:bg-gray-200 text-black w-10 h-10 rounded-full flex items-center justify-center absolute right-[210px] bottom-[50px] z-30 transition-transform hover:scale-110 shadow-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>

            <!-- Thumbnail Kanan (Next) -->
            <div class="relative w-[240px] h-[135px] group cursor-pointer" id="card-next">
              <img id="thumb-next" src="" alt="" class="w-full h-full object-cover opacity-50 group-hover:opacity-80 transition-opacity" />
              <div class="absolute inset-0 bg-black/50"></div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script is:inline>
  function initMediaPage() {
    const stage = document.getElementById("media-stage");
    if (!stage) return; 

    function autoScaleStage() {
      const baseWidth = 1920;
      const baseHeight = 1080;
      const scaleX = window.innerWidth / baseWidth;
      const scaleY = window.innerHeight / baseHeight;
      const scale = Math.min(scaleX, scaleY);

      stage.style.transform = `translate(-50%, -50%) scale(${scale})`;
      stage.style.left = "50%";
      stage.style.top = "50%";
    }

    autoScaleStage();
    window.addEventListener("resize", autoScaleStage);

    if (window.mediaCarouselInitialized) return;
    window.mediaCarouselInitialized = true;

    const mediaList = [
      {
        category: "ANIME",
        date: "2026-02-15",
        title: "Eighty-Six: Juggernaut Operations",
        desc: "Dokumentasi pertempuran skuad Spearhead. Menampilkan taktik manuver lapangan dan komunikasi radio yang intens di medan perang.",
        ytId: "QxRdIEoeLjo" 
      },
      {
        category: "GAMING",
        date: "2026-02-10",
        title: "Silent Hill: Fog Exploration",
        desc: "Analisis elemen horor psikologis. Menyoroti desain environment berkabut dan pendekatan tata suara khas dari franchise klasik ini.",
        ytId: "tK1kL_mF6Ew"
      },
      {
        category: "OS CONFIG",
        date: "2025-11-20",
        title: "Arch Linux x Hyprland",
        desc: "Demonstrasi setup Tiling Window Manager kustom. Menampilkan kelancaran workflow untuk proses debugging dan manajemen resource sistem.",
        ytId: "9sT_M7K6p3c" 
      },
      {
        category: "TRADING",
        date: "2026-05-01",
        title: "Market Analysis & Order Book",
        desc: "Pantauan pergerakan emiten pasar modal. Analisis live order book secara real-time untuk mengeksekusi strategi transaksi berkecepatan tinggi.",
        ytId: "5c-r529w4h8"
      },
      {
        category: "GAMING",
        date: "2026-02-28",
        title: "Minecraft: System Architecture",
        desc: "Eksplorasi pembuatan sirkuit logika kompleks menggunakan Redstone, mereplikasikan prinsip dasar komputasi dan gerbang logika.",
        ytId: "MmB9b5njVbA"
      }
    ];

    let currentIndex = 0;
    const getYtThumbnail = (id) => `https://img.youtube.com/vi/${id}/maxresdefault.jpg`;

    function updateMediaUI() {
      const prevIndex = currentIndex === 0 ? mediaList.length - 1 : currentIndex - 1;
      const nextIndex = currentIndex === mediaList.length - 1 ? 0 : currentIndex + 1;

      const currentData = mediaList[currentIndex];
      const prevData = mediaList[prevIndex];
      const nextData = mediaList[nextIndex];

      const elCategory = document.getElementById("media-category");
      const elDate = document.getElementById("media-date");
      const elTitle = document.getElementById("media-title");
      const elDesc = document.getElementById("media-desc");
      const elCounter = document.getElementById("media-counter");

      const bgMain = document.getElementById("main-bg");
      const thumbPrev = document.getElementById("thumb-prev");
      const thumbCurr = document.getElementById("thumb-curr");
      const thumbNext = document.getElementById("thumb-next");

      elTitle.style.opacity = "0";
      elDesc.style.opacity = "0";
      bgMain.style.opacity = "0.2"; 

      setTimeout(() => {
        elCategory.textContent = currentData.category;
        elDate.textContent = currentData.date;
        elTitle.textContent = currentData.title;
        elDesc.textContent = currentData.desc;
        elCounter.textContent = (currentIndex + 1).toString();

        bgMain.src = getYtThumbnail(currentData.ytId);
        thumbPrev.src = getYtThumbnail(prevData.ytId);
        thumbCurr.src = getYtThumbnail(currentData.ytId);
        thumbNext.src = getYtThumbnail(nextData.ytId);

        elTitle.style.opacity = "1";
        elDesc.style.opacity = "1";
        bgMain.style.opacity = "0.6"; 
      }, 200);
    }

    const goPrev = () => {
      currentIndex = currentIndex === 0 ? mediaList.length - 1 : currentIndex - 1;
      updateMediaUI();
    };

    const goNext = () => {
      currentIndex = currentIndex === mediaList.length - 1 ? 0 : currentIndex + 1;
      updateMediaUI();
    };

    // Menggunakan querySelectorAll agar semua tombol dengan class terkait berfungsi
    document.querySelectorAll(".btn-prev").forEach(btn => btn.addEventListener("click", goPrev));
    document.querySelectorAll(".btn-next").forEach(btn => btn.addEventListener("click", goNext));
    
    document.getElementById("card-prev").addEventListener("click", goPrev);
    document.getElementById("card-next").addEventListener("click", goNext);

    updateMediaUI();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMediaPage);
  } else {
    initMediaPage();
  }
  
  document.addEventListener("astro:page-load", initMediaPage);
</script>