---
import "../styles/global.css";
---

<section
  class="relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-black font-sans text-white py-16 lg:h-screen lg:py-0"
  id="EducationHistoryPage"
>
  {/* Grid Background Halus Biar Tetap Matching tapi Gak Polos-Polos Amat */}
  <div class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(#ffffff0a_1px,transparent_1px)] [background-size:24px_24px] opacity-40" aria-hidden="true"></div>

  <div
    id="game-stage"
    class="relative z-10 mx-auto flex h-full w-full max-w-7xl flex-col justify-center px-6 lg:px-12"
  >
    {/* HEADER HUD */}
    <div class="mb-8 flex flex-col items-start lg:mb-12">
      <div class="mb-2 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] text-[#FF7873]">
        <span class="inline-block h-1.5 w-1.5 bg-[#FF7873]"></span>
        <span>RAKA PORTFOLIO</span>
      </div>
      <h2 class="text-3xl font-extrabold uppercase tracking-[0.2em] text-white lg:text-5xl">
        EDUCATION
      </h2>
      <div class="mt-3 flex items-center gap-1.5">
        <div class="h-1 w-8 bg-[#FF7873]"></div>
        <div class="h-1 w-2 bg-white/40"></div>
        <div class="h-1 w-2 bg-white/20"></div>
      </div>
    </div>

    {/* MAIN CONTENT GRID */}
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
      
{/* LEFT COLUMN: FRAME FOTO HUD FLEKSIBEL */}
<div class="flex justify-center lg:col-span-5 lg:justify-start">
  <div class="edu-arch-frame relative w-full max-w-[420px] p-3 border border-white/10 bg-white/[0.02] backdrop-blur-sm lg:max-w-[500px]">
    {/* Corner accents */}
    <span class="edu-arch-corner edu-arch-corner--tl"></span>
    <span class="edu-arch-corner edu-arch-corner--tr"></span>
    <span class="edu-arch-corner edu-arch-corner--bl"></span>
    <span class="edu-arch-corner edu-arch-corner--br"></span>

    {/* Aspect ratio diubah ke 4/3 biar muat foto lanskap tanpa kepotong */}
    <div class="edu-arch-frame__inner relative aspect-[4/3] w-full overflow-hidden border border-white/10 bg-black/80 sm:aspect-[16/10]">
      
      {/* Background blur bayangan foto (opsional, biar frame gak kosong kalau foto beda rasio) */}
      <img
        id="edu-img-bg"
        src="/SDN.jpg"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20 blur-md scale-110 pointer-events-none"
      />

      {/* Foto Utama: object-contain biar FULL kelihatan tanpa terpotong */}
      <img
        id="edu-img"
        src="/SDN.jpg"
        alt="Education Photo"
        class="relative z-10 h-full w-full object-contain p-1 transition-all duration-300"
      />
    </div>

    <div class="mt-2 flex items-center justify-between font-mono text-[10px] uppercase tracking-widest text-gray-400">
      <span>SYS // REF-IMG</span>
      <span>ASPECT: FLEXIBLE</span>
    </div>
  </div>
</div>
      {/* RIGHT COLUMN: INFO & NAVIGASI TAB */}
      <div class="flex flex-col justify-between lg:col-span-7">
        <div>
          <p class="mb-2 font-mono text-xs uppercase tracking-widest text-[#FF7873]">
            // RAKA: EDUCATION-HISTORY
          </p>

          <h1
            id="edu-title"
            class="mb-4 min-h-[60px] text-2xl font-bold uppercase tracking-wider text-white lg:text-4xl"
          >
            SDN 034 PATRAKOMALA KOTA BANDUNG
          </h1>

          <p
            id="edu-desc"
            class="mb-8 min-h-[90px] text-sm leading-relaxed text-gray-300/90 lg:text-base"
          >
            Masa pendidikan dasar. Mulai belajar banyak hal baru dan berinteraksi dengan lingkungan sekitar.
          </p>
        </div>

        {/* LIST TAB SEKOLAH */}
        <div class="mb-8">
          <p class="mb-3 font-mono text-[11px] uppercase tracking-widest text-gray-500">SELECT LEVEL:</p>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
            <button class="edu-list-item" data-index="0">TK</button>
            <button class="edu-list-item active-edu" data-index="1">SDN PATRA</button>
            <button class="edu-list-item" data-index="2">SMPN 7</button>
            <button class="edu-list-item" data-index="3">SMKN 2</button>
          </div>
        </div>

        {/* PROGRESS & BUTTON CONTROL */}
        <div class="border-t border-white/10 pt-6">
          <div class="mb-6 flex items-center justify-between">
            <div id="edu-progress-container" class="flex gap-2"></div>
            <p id="edu-counter" class="font-mono text-sm font-bold tracking-widest text-[#FF7873]">
              2 / 4
            </p>
          </div>

          {/* BUTTON NAVIGASI */}
          <div class="flex items-center gap-4">
            <button
              id="btn-prev"
              type="button"
              class="edu-nav-btn flex-1"
              aria-label="Previous school"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
              <span>PREVIOUS</span>
            </button>
            <button
              id="btn-next"
              type="button"
              class="edu-nav-btn edu-nav-btn--primary flex-1"
              aria-label="Next school"
            >
              <span>NEXT</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        </div>

      </div>

    </div>

    {/* FOOTER METADATA */}
    <div class="mt-12 hidden justify-between font-mono text-[11px] tracking-widest text-gray-600 lg:flex">
      <span>V.1-ENTRY&#8968;2:10&#8969;</span>
      <span>PPLG / RPL SYSTEM</span>
    </div>
  </div>
</section>

<style>
  /* CORNER HUD STYLES */
  .edu-arch-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: #FF7873;
    border-style: solid;
    z-index: 10;
  }
  .edu-arch-corner--tl { top: -1px; left: -1px; border-width: 2px 0 0 2px; }
  .edu-arch-corner--tr { top: -1px; right: -1px; border-width: 2px 2px 0 0; }
  .edu-arch-corner--bl { bottom: -1px; left: -1px; border-width: 0 0 2px 2px; }
  .edu-arch-corner--br { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }

  /* LIST ITEM (TAB) STYLES */
  .edu-list-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1rem;
    font-family: monospace;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 3px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .edu-list-item:hover:not(.active-edu) {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .edu-list-item.active-edu {
    background: rgba(255, 120, 115, 0.12);
    color: #fff;
    border-color: rgba(255, 120, 115, 0.4);
    border-left-color: #FF7873;
  }

  /* BUTTON STYLES */
  .edu-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 46px;
    padding: 0 1.5rem;
    font-family: monospace;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .edu-nav-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .edu-nav-btn--primary {
    background: #FF7873;
    border-color: #FF7873;
    color: #000;
  }

  .edu-nav-btn--primary:hover:not(:disabled) {
    background: #ff8e8a;
    border-color: #ff8e8a;
    color: #000;
  }

  .edu-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
</style>

<script>
  import { fadeTransition } from "../Script/gsap-utils";

  const educationData = [
    {
      title: "TAMAN KANAK-KANAK",
      shortTitle: "TK",
      desc: "Masa awal pengenalan lingkungan sekolah dan interaksi dasar.",
      img: "/bg2.jpg",
    },
    {
      title: "SDN 034 PATRAKOMALA KOTA BANDUNG",
      shortTitle: "SDN PATRA",
      desc: "SDN 034 Patrakomala merupakan sekolah dasar negeri yang berlokasi di Jalan Patrakomala No. 63, Kelurahan Merdeka, Kecamatan Sumur Bandung, Kota Bandung. Sekolah ini memiliki akreditasi A.",
      img: "/SDN.jpg",
    },
    {
      title: "SMPN 7 BANDUNG",
      shortTitle: "SMPN 7",
      desc: "SMPN 7 Bandung adalah sekolah menengah pertama negeri berstatus unggulan di Kota Bandung. Menjabat sebagai ketua kelas di kelas 7 dan wakil di kelas 8, serta aktif dalam ekstrakurikuler Seni Lukis dan Jurnal 7.",
      img: "/SMP.jpg",
    },
    {
      title: "SMKN 2 BANDUNG",
      shortTitle: "SMKN 2",
      desc: "SMKN 2 Bandung adalah sekolah kejuruan negeri di Bandung. Menempuh pendidikan jurusan PPLG/RPL, fokus pada pengembangan keterampilan teknis software development, serta aktif di Japanese Club, English Club, CreoFrame, dan Kasantara Game Studio.",
      img: "/SMK.jpeg",
    },
  ];

  let currentIndex = 1;
  let switching = false;

  const transitionTargets = ["#edu-title", "#edu-desc", "#edu-img", "#edu-counter"].filter(
    (s) => document.querySelector(s)
  );

  function renderEduProgress() {
    const container = document.getElementById("edu-progress-container");
    if (!container) return;
    container.innerHTML = "";
    educationData.forEach((_, i) => {
      const bar = document.createElement("div");
      bar.className = `h-1 transition-all duration-300 ${i === currentIndex ? "w-8 bg-[#FF7873]" : "w-3 bg-white/20"}`;
      container.appendChild(bar);
    });
  }

  function setNavDisabled(disabled) {
    const btnPrev = document.getElementById("btn-prev") as HTMLButtonElement | null;
    const btnNext = document.getElementById("btn-next") as HTMLButtonElement | null;
    if (btnPrev) btnPrev.disabled = disabled;
    if (btnNext) btnNext.disabled = disabled;
  }

function updateEducationUI(index, animate = true) {
  const titleEl = document.getElementById("edu-title");
  const descEl = document.getElementById("edu-desc");
  const imgEl = document.getElementById("edu-img") as HTMLImageElement | null;
  const imgBgEl = document.getElementById("edu-img-bg") as HTMLImageElement | null; // Tambahkan ini
  const counterEl = document.getElementById("edu-counter");
  const listItems = document.querySelectorAll(".edu-list-item");
  const data = educationData[index];

  const apply = () => {
    if (titleEl) titleEl.textContent = data.title;
    if (descEl) descEl.textContent = data.desc;
    if (imgEl) imgEl.src = data.img;
    if (imgBgEl) imgBgEl.src = data.img; // Set background blur sesuai gambar aktif
    if (counterEl)
      counterEl.textContent = `${index + 1} / ${educationData.length}`;

    listItems.forEach((li, i) => {
      li.classList.toggle("active-edu", i === index);
    });
    renderEduProgress();
  };

  if (animate && transitionTargets.length > 0) {
    setNavDisabled(true);
    fadeTransition(transitionTargets, apply, { duration: 0.22 }).eventCallback(
      "onComplete",
      () => {
        switching = false;
        setNavDisabled(false);
      }
    );
  } else {
    apply();
    switching = false;
    setNavDisabled(false);
  }
}

  function initNavigasi() {
    const btnPrev = document.getElementById("btn-prev");
    const btnNext = document.getElementById("btn-next");
    const listItems = document.querySelectorAll(".edu-list-item");

    listItems.forEach((li) => {
      li.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        if (switching || target.classList.contains("active-edu")) return;
        switching = true;
        currentIndex = parseInt(target.getAttribute("data-index") || "0", 10);
        updateEducationUI(currentIndex);
      });
    });

    btnPrev?.addEventListener("click", () => {
      if (switching) return;
      switching = true;
      currentIndex = currentIndex - 1 < 0 ? educationData.length - 1 : currentIndex - 1;
      updateEducationUI(currentIndex);
    });

    btnNext?.addEventListener("click", () => {
      if (switching) return;
      switching = true;
      currentIndex = currentIndex + 1 >= educationData.length ? 0 : currentIndex + 1;
      updateEducationUI(currentIndex);
    });

    updateEducationUI(currentIndex, false);
  }

  document.addEventListener("DOMContentLoaded", () => {
    initNavigasi();
  });
</script>