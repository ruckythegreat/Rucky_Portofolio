<!-- Script Auto-Scale -->
<script>
  function autoScaleStage() {
    const stage = document.getElementById('game-stage');
    if (!stage) return;

    // Resolusi dasar Windows / Full HD
    const baseWidth = 1920;
    const baseHeight = 1080;

    // Hitung perbandingan terhadap layar aktif
    const scaleX = window.innerWidth / baseWidth;
    const scaleY = window.innerHeight / baseHeight;

    // Gunakan nilai terkecil agar tidak ada elemen terpotong
    const scale = Math.min(scaleX, scaleY);

    // Terapkan scaling secara otomatis
    stage.style.transform = `scale(${scale})`;
  }

  // Jalankan saat pertama kali dibuka & saat ukuran window/zoom berubah
  window.addEventListener('resize', autoScaleStage);
  document.addEventListener('DOMContentLoaded', autoScaleStage);
</script>