---
import "../styles/global.css";
---
<section
  class="relative mt-40 w-screen h-screen overflow-hidden flex items-center justify-center bg-black"
  id="EducationHistoryPage"
>
  <div id="game-stage" class="w-[1920px] h-[1080px] relative origin-center shrink-0">
    <div class="flex flex-col items-center h-full p-16">
      
      <div class="absolute top-3 left-120">
        <h2 class="relative text-3xl text-white font-bold">
          RUCKY: EDUCATION
        </h2>
        <h2 class="relative text-5xl text-white font-bold">
          HISTORY
        </h2>
      </div>

      <div class="absolute top-150 left-300 flex flex-col items-start text-white">
        <p class="m-1">RUCKY: EDUCATION-HISTORY</p>
        <h1 id="edu-title" class="text-5xl m-1">SDN PATRAKOMALA</h1>

        <p id="edu-desc" class="m-1 max-w-3xl">
          Masa pendidikan dasar. Mulai belajar banyak hal baru dan berinteraksi dengan lingkungan sekitar. Membangun fondasi awal sebelum mengenal dunia teknologi lebih dalam.
        </p>

        <img id="edu-img" src="/bg3.jpg" alt="" class="absolute right-185 h-200" />
      </div>

      <div class="absolute top-[680px] left-[300px] flex flex-col items-start text-white">
        <p id="edu-counter" class="absolute -top-8 left-[120px] text-gray-400">
          2/4
        </p>
        
        <ul class="space-y-2">
          <li class="edu-list-item cursor-pointer px-2 transition-all duration-200" data-index="0">TK</li>
          <li class="edu-list-item cursor-pointer px-2 transition-all duration-200 font-bold bg-[#FF7873]" data-index="1">SDN PATRA</li>
          <li class="edu-list-item cursor-pointer px-2 transition-all duration-200" data-index="2">SMPN 7</li>
          <li class="edu-list-item cursor-pointer px-2 transition-all duration-200" data-index="3">SMKN 2</li>
        </ul>

        <div id="btn-prev" class="bg-[#FF7873] w-10 h-10 absolute left-[0px] top-50 flex items-center justify-center cursor-pointer hover:bg-orange-300 transition-colors">
          <p class="text-2xl text-black font-bold">&lt;</p>
        </div>

        <div id="btn-next" class="bg-[#FF7873] w-10 h-10 absolute left-[70px] top-50 flex items-center justify-center cursor-pointer hover:bg-orange-300 transition-colors">
          <p class="text-2xl text-black font-bold">&gt;</p>
        </div>
      </div>

      <p class="relative top-200 left-180 mt-6 text-gray-400 max-w-3xl">
        V.1-Entry&#8968;2/10&#8969;
      </p>

      <div class="top-15 absolute h-[120px] w-[19000px] flex z-[-3] bg-[rgb(255,201,148)] text-4xl -translate-y-1/2">
      </div>

    </div>
  </div>
</section>

<script>
  import { glitchTransition } from "../Script/gsap-utils";

  const educationData = [
    {
      title: "TAMAN KANAK-KANAK",
      shortTitle: "TK",
      desc: "Masa perkenalan dengan dunia pendidikan. Bermain sambil belajar untuk melatih motorik dan kreativitas dasar sebelum memasuki jenjang sekolah dasar.",
      img: "/bg2.jpg"
    },
    {
      title: "SDN PATRAKOMALA",
      shortTitle: "SDN PATRA",
      desc: "Masa pendidikan dasar. Mulai belajar banyak hal baru, disiplin, dan berinteraksi dengan lingkungan sekitar. Membangun fondasi awal sebelum mengenal dunia teknologi lebih dalam.",
      img: "/bg3.jpg"
    },
    {
      title: "SMPN 7 BANDUNG",
      shortTitle: "SMPN 7",
      desc: "Masa sekolah menengah pertama. Mulai mengeksplorasi minat dan bakat secara lebih spesifik, serta menjadi jembatan awal sebelum benar-benar mendalami dunia komputer.",
      img: "/bg4.jpg"
    },
    {
      title: "SMKN 2 BANDUNG",
      shortTitle: "SMKN 2",
      desc: "Saat ini menempuh pendidikan di kelas 10 jurusan Pengembangan Perangkat Lunak dan Gim (PPLG). Mulai fokus menguasai bahasa pemrograman (C++, Golang), sistem operasi Linux kustom, dan arsitektur perangkat lunak.",
      img: "/bg5.jpg"
    }
  ];

  let currentIndex = 1;
  let switching = false;
  const glitchTargets = ['#edu-title', '#edu-desc', '#edu-img', '#edu-counter'];

  function updateEducationUI(index, animate = true) {
    const titleEl = document.getElementById('edu-title');
    const descEl = document.getElementById('edu-desc');
    const imgEl = document.getElementById('edu-img');
    const counterEl = document.getElementById('edu-counter');
    const listItems = document.querySelectorAll('.edu-list-item');
    const data = educationData[index];

    const apply = () => {
      titleEl.textContent = data.title;
      descEl.textContent = data.desc;
      imgEl.src = data.img;
      counterEl.textContent = `${index + 1}/${educationData.length}`;
      listItems.forEach((li, i) => {
        if (i === index) li.classList.add('font-bold', 'bg-[#FF7873]');
        else li.classList.remove('font-bold', 'bg-[#FF7873]');
      });
    };

    if (animate) glitchTransition(glitchTargets, apply);
    else apply();
  }

  function autoScaleStage() {
    const stage = document.getElementById('game-stage');
    if (!stage) return;

    const baseWidth = 1920;
    const baseHeight = 1080;
    const scale = Math.min(window.innerWidth / baseWidth, window.innerHeight / baseHeight);
    stage.style.transform = `scale(${scale})`;
  }

  function initNavigasi() {
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const listItems = document.querySelectorAll('.edu-list-item');

    btnPrev.addEventListener('click', () => {
      currentIndex--;
      if (currentIndex < 0) {
        currentIndex = educationData.length - 1;
      }
      updateEducationUI(currentIndex);
    });

    btnNext.addEventListener('click', () => {
      currentIndex++;
      if (currentIndex >= educationData.length) {
        currentIndex = 0;
      }
      updateEducationUI(currentIndex);
    });

    listItems.forEach((li) => {
      li.addEventListener('click', (e) => {
        const clickedIndex = parseInt(e.target.getAttribute('data-index'));
        currentIndex = clickedIndex;
        updateEducationUI(currentIndex);
      });
    });

    updateEducationUI(currentIndex, false);
  }

  window.addEventListener('resize', autoScaleStage);
  document.addEventListener('DOMContentLoaded', () => {
    autoScaleStage();
    initNavigasi();
  });
</script>