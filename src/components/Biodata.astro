---
import "../styles/global.css";
---

<section
  class="relative mb-20 w-full min-h-screen overflow-hidden flex items-center justify-center bg-white lg:mt-40 lg:h-screen lg:w-screen"
  id="BiodataPage"
>
  <div
    id="game-stage-biodata"
    class="w-full h-auto relative origin-center shrink-0 lg:absolute lg:h-[1080px] lg:w-[1920px]"
  >
    <div class="relative flex flex-col w-full h-full px-6 py-24 z-10 lg:items-center lg:p-16">
      
      <!-- TITLE HEADER -->
      <h2
        class="relative text-3xl font-bold text-black flex items-center gap-3 mb-2 lg:top-20 lg:right-100 lg:mb-0 lg:text-5xl drop-shadow-sm"
      >
        [About Raka]
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-folder-plus-icon lucide-folder-plus lg:h-10 lg:w-10"
        ><path d="M12 10v6"></path><path d="M9 13h6"></path><path
            d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
          ></path></svg>
      </h2>

      <!-- COUNTER -->
      <p class="relative text-sm text-gray-500 mb-8 max-w-3xl font-mono tracking-wider lg:top-200 lg:left-180 lg:mt-6 lg:mb-0 lg:text-base lg:text-gray-500">
        V.1-Entry&#8968;1:10&#8969; [<span id="dynamic-counter" class="font-bold text-black">1</span>/5]
      </p>

      <!-- MENU BUTTONS -->
      <div
        class="relative w-full grid grid-cols-2 gap-3 mb-10 z-30 lg:absolute lg:flex lg:flex-col lg:items-start lg:w-[350px] lg:top-[300px] lg:left-[180px] lg:space-y-3 lg:gap-0 lg:p-2 lg:mb-0 lg:block"
      >
        <div class="hidden lg:flex w-full justify-center mb-4 opacity-50">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up text-black"><path d="m18 15-6-6-6 6"></path></svg>
        </div>

        <button class="w-full text-left menu-btn bg-black text-white px-5 py-4 text-xs md:text-sm font-bold uppercase tracking-wide border border-transparent transition-shadow hover:shadow-lg lg:px-8 lg:py-4 lg:text-xl" data-target="personal">
          Personal
        </button>
        <button class="w-full text-left menu-btn bg-black text-white px-5 py-4 text-xs md:text-sm font-bold uppercase tracking-wide border border-transparent transition-shadow hover:shadow-lg lg:px-8 lg:py-4 lg:text-xl" data-target="strengths">
          Strengths
        </button>
        <button class="w-full text-left menu-btn bg-black text-white px-5 py-4 text-xs md:text-sm font-bold uppercase tracking-wide border border-transparent transition-shadow hover:shadow-lg lg:px-8 lg:py-4 lg:text-xl" data-target="weaknesses">
          Weaknesses
        </button>
        <button class="w-full text-left menu-btn bg-black text-white px-5 py-4 text-xs md:text-sm font-bold uppercase tracking-wide border border-transparent transition-shadow hover:shadow-lg lg:px-8 lg:py-4 lg:text-xl" data-target="hobbies">
          Hobbies
        </button>
        <button class="w-full text-left menu-btn bg-black text-white px-5 py-4 text-xs md:text-sm font-bold uppercase tracking-wide border border-transparent transition-shadow hover:shadow-lg col-span-2 lg:col-span-1 lg:px-8 lg:py-4 lg:text-xl" data-target="purpose">
          Purpose
        </button>

        <div class="hidden lg:flex w-full justify-center mt-4 opacity-50">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-black"><path d="m6 9 6 6 6-6"></path></svg>
        </div>
      </div>

      <!-- DYNAMIC CONTENT (Title & Description Card) -->
      <div
        class="relative w-full flex flex-col items-start z-30 bg-white/80 backdrop-blur-xl p-8 border border-slate-200/60 shadow-[0_8px_30px_rgb(0,0,0,0.06)] rounded-xl lg:bg-white/85 lg:backdrop-blur-2xl lg:p-12 lg:border-white/50 lg:shadow-2xl lg:absolute lg:w-[600px] lg:top-[300px] lg:left-[550px]"
      >
        <h1 id="dynamic-title" class="text-black text-3xl lg:text-5xl font-extrabold mb-6 tracking-tight">
          [Title]
        </h1>
        <p id="dynamic-desc" class="text-slate-800 text-left text-base lg:text-xl leading-relaxed lg:leading-[1.7]">
          Pilih menu di bawah untuk melihat detail informasi.
        </p>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down-left hidden lg:block mt-8 text-black opacity-40"><path d="M17 7 7 17"></path><path d="M17 17H7V7"></path></svg>
      </div>

      <!-- IMAGE -->
      <div
        class="absolute inset-0 opacity-15 pointer-events-none z-[-1] overflow-hidden lg:opacity-100 lg:w-[600px] lg:p-6 lg:flex lg:flex-col lg:justify-center lg:left-200 lg:top-0 lg:-translate-y-1/2"
      >
        <img
          id="dynamic-img"
          src="/bg1.jpg"
          alt="Rucky"
          class="w-full h-full object-cover lg:w-120 lg:h-210 lg:absolute lg:left-70 lg:top-30 lg:mix-blend-plus-lighter drop-shadow-2xl"
        />
      </div>

      <!-- DEKORASI DESKTOP ONLY -->
      <div class="hidden lg:block absolute top-15 right-85 text-black/40">
        <svg xmlns="http://www.w3.org/2000/svg" width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-land-plot"><path d="m12 8 6-3-6-3v10"></path><path d="m8 11.99-5.5 3.14a1 1 0 0 0 0 1.74l8.5 4.86a2 2 0 0 0 2 0l8.5-4.86a1 1 0 0 0 0-1.74L16 12"></path><path d="m6.49 12.85 11.02 6.3"></path><path d="M17.51 12.85 6.5 19.15"></path></svg>
      </div>

      <div class="hidden lg:block absolute bottom-10 left-10 text-black/40">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down-left"><path d="M17 7 7 17"></path><path d="M17 17H7V7"></path></svg>
      </div>

      <!-- Dynamic Extra Info -->
      <div class="hidden lg:flex absolute w-[600px] p-6 flex-col justify-center left-390 top-150 text-black text-4xl -translate-y-1/2">
        <p id="dynamic-extra" class="font-extrabold tracking-widest text-slate-800">PPLG_</p>
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-group mt-2 text-black"><path d="M3 7V5c0-1.1.9-2 2-2h2"></path><path d="M17 3h2c1.1 0 2 .9 2 2v2"></path><path d="M21 17v2c0 1.1-.9 2-2 2h-2"></path><path d="M7 21H5c-1.1 0-2-.9-2-2v-2"></path><rect width="7" height="5" x="7" y="7" rx="1"></rect><rect width="7" height="5" x="10" y="12" rx="1"></rect></svg>
      </div>

      <!-- Teks RUCKY PORTO Raksasa -->
      <div class="hidden lg:block absolute z-[-2] left-120 top-120 -translate-y-1/2 pointer-events-none font-black tracking-tighter">
        <p style="font-size: 250px; color: rgba(0, 0, 0, 0.04); white-space: nowrap;">RAKA PORTO</p>
      </div>

      <!-- Garis Warna-warni & Ikon Chevron/Grip (Warm Accent Palette) -->
      <div class="hidden lg:flex absolute top-247 z-[-2] right-260 items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevrons-right"><path d="m6 17 5-5-5-5"></path><path d="m13 17 5-5-5-5"></path></svg>
      </div>
      <div class="hidden lg:flex absolute top-47 z-[-2] right-60 items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-grip-vertical"><circle cx="9" cy="12" r="1"></circle><circle cx="9" cy="5" r="1"></circle><circle cx="9" cy="19" r="1"></circle><circle cx="15" cy="12" r="1"></circle><circle cx="15" cy="5" r="1"></circle><circle cx="15" cy="19" r="1"></circle></svg>
      </div>
      <div class="hidden lg:flex absolute top-147 z-[-2] right-260 items-center gap-1">
        <div class="w-24 h-1.5 bg-[#ffc994] rounded-full"></div>
        <div class="w-16 h-1.5 bg-[#FF7873] rounded-full"></div>
        <div class="w-8 h-1.5 bg-[#E22F80] rounded-full"></div>
      </div>
      <div class="hidden lg:flex absolute top-147 z-[-2] left-300 items-center gap-1">
        <div class="w-8 h-1.5 bg-[#E22F80] rounded-full"></div>
        <div class="w-16 h-1.5 bg-[#FF7873] rounded-full"></div>
        <div class="w-24 h-1.5 bg-[#ffc994] rounded-full"></div>
      </div>

      <!-- Masking background block -->
      <div class="hidden lg:flex absolute h-[500px] w-[400px] z-[-3] justify-center left-200 top-50 bg-[rgb(255,201,148)] text-4xl -translate-y-1/2">
        <div class="absolute opacity-80 h-[500px] w-[400px] flex z-[-3] justify-center top-220 bg-[rgb(255,201,148)] text-4xl -translate-y-1/2" style="mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 100%);"></div>
      </div>
      
    </div>
  </div>
</section>

<script>
  import { glitchTransition } from "../Script/gsap-utils";
  import gsap from "gsap";

  const biodataContent = {
    personal: {
      title: "[Personal Info]",
      desc: "Lahir di Bandung pada bulan November 2009. Tumbuh dan berkembang di Kota Bandung, membentuk kenyamanan mendalam terhadap atmosfer serta dinamika lingkungan lokal. Biasa disapa Rucky, sebuah panggilan unik yang memudahkan identifikasi profesional. Memiliki minat mendalam dan dedikasi tinggi di bidang pengembangan gim, pemrograman perangkat lunak, serta desain grafis.",
      img: "/bg1.jpg",
      extra: "PROFILE_01",
      counter: "1",
    },
    strengths: {
      title: "[Strengths]",
      desc: "Memiliki kemampuan adaptasi yang cepat terhadap lingkungan kerja yang dinamis, serta keterampilan belajar mandiri (fast learner) yang tinggi dalam menguasai bahasa pemrograman, analisis sistem, pemecahan masalah, hingga produksi multimedia. Aktif dalam kegiatan kolaboratif, memiliki komitmen tinggi terhadap tanggung jawab profesional, serta mampu bekerja secara efektif di dalam tim lintas disiplin.",
      img: "/bg2.jpg",
      extra: "SYS_ARCH",
      counter: "2",
    },
    weaknesses: {
      title: "[Weaknesses]",
      desc: "Memiliki kondisi fisik khusus pada kaki sejak lahir yang dikelola dengan komitmen mobilitas tinggi dan etos kerja profesional. Secara proaktif terus melatih ketelitian komunikasi, mengelola tempo bicara, serta meminimalisir distraksi melalui manajemen tugas yang terstruktur, evaluasi berkala, dan tanggung jawab penuh atas setiap penyelesaian proyek.",
      img: "/bg3.jpg",
      extra: "OVERCLOCK",
      counter: "3",
    },
    hobbies: {
      title: "[Hobbies]",
      desc: "Aktif mengeksplorasi seni digital dan tradisional, desain grafis, penyuntingan video, pemrograman gim dan aplikasi web, pemodelan 3D, serta analisis naratif media interaktif (anime dan film series). Seluruh hobi ini diselaraskan secara profesional untuk mendukung produktivitas teknis di industri kreatif.",
      img: "/bg4.jpg",
      extra: "CREATIVE_RUN",
      counter: "4",
    },
    purpose: {
      title: "[Purpose]",
      desc: "Berkomitmen untuk mengangkat kekayaan budaya Nusantara ke kancah industri gim global melalui pendekatan filosofis, naratif, dan mekanik gim yang imersif. Berdedikasi untuk menciptakan inovasi kreatif, memperluas jangkauan karya lokal, serta memperkenalkan identitas budaya Nusantara kepada audiens internasional melalui media hiburan digital.",
      img: "/bg5.jpg",
      extra: "GOAL_EXEC",
      counter: "5",
    },
  };

  function autoScaleBiodataStage() {
    const stage = document.getElementById("game-stage-biodata");
    if (!stage) return;

    if (window.innerWidth < 1024) {
      stage.style.transform = '';
      return; 
    }

    const baseWidth = 1920;
    const baseHeight = 1080;
    const scaleX = window.innerWidth / baseWidth;
    const scaleY = window.innerHeight / baseHeight;
    const scale = Math.min(scaleX, scaleY);

    stage.style.transform = `scale(${scale})`;
  }

  function initInteractions() {
    const menuButtons = document.querySelectorAll(".menu-btn");
    const titleEl = document.getElementById("dynamic-title");
    const descEl = document.getElementById("dynamic-desc");
    const imgEl = document.querySelector<HTMLImageElement>("#dynamic-img");
    const extraEl = document.getElementById("dynamic-extra");
    const counterEl = document.getElementById("dynamic-counter");

    const glitchTargets = [
      "#dynamic-title",
      "#dynamic-desc",
      "#dynamic-img",
      "#dynamic-extra",
      "#dynamic-counter",
    ].filter(selector => document.querySelector(selector) !== null);

    let switching = false;

    function applyContent(data: {
      title: string;
      desc: string;
      img: string;
      extra: string;
      counter: string;
    }) {
      if (titleEl) titleEl.textContent = data.title;
      if (descEl) descEl.textContent = data.desc;
      if (imgEl) imgEl.src = data.img;
      if (extraEl) extraEl.textContent = data.extra;
      if (counterEl) counterEl.textContent = data.counter;
    }

    menuButtons.forEach((btn) => {
      btn.addEventListener("mouseenter", () => {
        if (!btn.classList.contains("active-btn")) {
          const moveX = window.innerWidth < 1024 ? 0 : 20;
          gsap.to(btn, {
            x: moveX,
            backgroundColor: "#ffc994",
            color: "#000000",
            duration: 0.3,
            ease: "power2.out",
          });
        }
      });

      btn.addEventListener("mouseleave", () => {
        if (!btn.classList.contains("active-btn")) {
          gsap.to(btn, {
            x: 0,
            backgroundColor: "#000000",
            color: "#ffffff",
            duration: 0.3,
            ease: "power2.inOut",
          });
        }
      });

      btn.addEventListener("click", () => {
        if (switching || btn.classList.contains("active-btn")) return;
        switching = true;

        menuButtons.forEach((b) => {
          b.classList.remove("active-btn", "border-black");
          gsap.to(b, {
            x: 0,
            backgroundColor: "#000000",
            color: "#ffffff",
            duration: 0.3,
          });
        });

        btn.classList.add("active-btn", "border-black");
        
        const moveX = window.innerWidth < 1024 ? 0 : 20;
        gsap.to(btn, {
          x: moveX,
          backgroundColor: "#ffc994",
          color: "#000000",
          duration: 0.3,
        });

        const target = btn.getAttribute("data-target");
        if (!target || !(target in biodataContent)) return;

        const data = biodataContent[target as keyof typeof biodataContent];

        glitchTransition(glitchTargets, () => applyContent(data)).eventCallback(
          "onComplete",
          () => {
            switching = false;
          },
        );
      });
    });

    if (menuButtons.length > 0) {
      const firstBtn = menuButtons[0];
      firstBtn.classList.add("active-btn", "border-black");
      
      const moveX = window.innerWidth < 1024 ? 0 : 20;
      gsap.set(firstBtn, {
        x: moveX,
        backgroundColor: "#ffc994",
        color: "#000000",
      });
      applyContent(biodataContent.personal);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    autoScaleBiodataStage();
    initInteractions();
  });

  window.addEventListener("resize", () => {
    autoScaleBiodataStage();
    const menuButtons = document.querySelectorAll(".menu-btn");
    menuButtons.forEach((btn) => {
      if (window.innerWidth < 1024) {
        gsap.set(btn, { x: 0 });
      } else if (btn.classList.contains("active-btn")) {
        gsap.set(btn, { x: 20 });
      }
    });
  });
</script>