              </svg>
            </div>
            <span class="nav-label hidden whitespace-nowrap text-sm font-bold uppercase tracking-wider lg:block lg:ml-5">
              Social
            </span>
          </a>
        </li>

        <!-- ==================== CONTACT ==================== -->
        <li class="nav-item w-auto flex-1 lg:w-full">
          <a
            href="/#ContactPage"
            class="nav-link flex flex-col items-center justify-center py-2 text-slate-400 transition-colors hover:bg-white/10 hover:text-white lg:flex-row lg:py-4 lg:pl-[28px] lg:justify-start lg:w-full"
            title="Contact"
          >
            <div class="icon-container flex h-6 w-6 shrink-0 items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 2v2" />
                <path d="M7 21v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2" />
                <path d="M8 2v2" />
                <circle cx="12" cy="10" r="3" />
                <rect x="3" y="3" width="18" height="18" rx="2" />
              </svg>
            </div>
            <span class="nav-label hidden whitespace-nowrap text-sm font-bold uppercase tracking-wider lg:block lg:ml-5">
              Contact
            </span>
          </a>
        </li>

      </ul>
    </div>
  </div>
</nav>

<script>
  import { gsap } from "../Script/gsap-utils";

  function autoScaleNavigation() {
    const stage = document.getElementById("nav-stage");
    if (!stage) return;

    if (window.innerWidth < 1024) {
      stage.style.transform = '';
      return; 
    }

    const baseWidth = 1920;
    const baseHeight = 1080;
    const scaleX = window.innerWidth / baseWidth;
    const scaleY = window.innerHeight / baseHeight;
    const scale = Math.min(scaleX, scaleY);
    
    stage.style.transform = `scale(${scale})`;
  }

  function initSidebarExpansion() {
    const sidebar = document.getElementById("sidebar");
    const labels = document.querySelectorAll(".nav-label");
    const links = document.querySelectorAll(".nav-link");

    if (!sidebar) return;

    let mm = gsap.matchMedia();

    mm.add("(min-width: 1024px)", () => {
      gsap.set(labels, { autoAlpha: 0, x: -15 });

      const sidebarTl = gsap.timeline({ paused: true })
        .to(sidebar, { width: 260, duration: 0.45, ease: "power3.inOut" })
        .to(labels, { autoAlpha: 1, x: 0, duration: 0.3, stagger: 0.03, ease: "power2.out" }, "-=0.25");

      const onEnter = () => sidebarTl.play();
      const onLeave = () => sidebarTl.reverse();

      const onLinkEnter = (e) => gsap.to(e.currentTarget.querySelector('.icon-container'), { scale: 1.15, duration: 0.3, ease: "back.out(2)" });
      const onLinkLeave = (e) => gsap.to(e.currentTarget.querySelector('.icon-container'), { scale: 1, duration: 0.3, ease: "power2.out" });

      sidebar.addEventListener("mouseenter", onEnter);
      sidebar.addEventListener("mouseleave", onLeave);

      links.forEach((link) => {
        link.addEventListener("mouseenter", onLinkEnter);
        link.addEventListener("mouseleave", onLinkLeave);
      });

      return () => {
        sidebar.removeEventListener("mouseenter", onEnter);
        sidebar.removeEventListener("mouseleave", onLeave);
        links.forEach((link) => {
          link.removeEventListener("mouseenter", onLinkEnter);
          link.removeEventListener("mouseleave", onLinkLeave);
        });
        
        gsap.set([sidebar, labels], { clearProps: "all" });
      };
    });
  }

  autoScaleNavigation();
  initSidebarExpansion();

  window.addEventListener("resize", autoScaleNavigation);
</script>