---
import "../styles/global.css";
---

<nav
  id="side-nav"
  class="fixed left-0 top-0 z-50 h-screen w-screen overflow-hidden pointer-events-none"
>
  <!-- 1. Ubah pointer-events-auto menjadi pointer-events-none pada stage -->
  <div
    id="nav-stage"
    class="absolute left-0 top-0 h-[1080px] w-[1920px] origin-top-left pointer-events-none"
  >
    <!-- 2. Pindahkan pointer-events-auto hanya ke pembungkus sidebar yang berukuran 80px -->
    <div
      class="absolute left-0 top-0 flex h-[1080px] w-[80px] flex-col items-center border-r border-slate-800 bg-slate-900 py-6 backdrop-blur-sm pointer-events-auto"
    >
      <!-- Logo -->
      <a
        href="#WelcomePage"
        class="mb-12 flex h-10 w-10 items-center justify-center bg-white font-extrabold text-black"
      >
        R.
      </a>

      <!-- Navigation -->
      <ul class="flex w-full flex-col items-center gap-6">
        <li class="w-full">
          <a
            href="#WelcomePage"
            class="flex w-full justify-center py-3 hover:bg-white/10"
            title="Welcome"
          >
            <div class="h-6 w-6 rounded-sm bg-slate-400"></div>
          </a>
        </li>

        <li class="w-full">
          <a
            href="#MediaPage"
            class="flex w-full justify-center py-3 hover:bg-white/10"
            title="Media"
          >
            <div class="h-6 w-6 rounded-full bg-slate-400"></div>
          </a>
        </li>

        <li class="w-full">
          <a
            href="#ProjectPage"
            class="flex w-full justify-center py-3 hover:bg-white/10"
            title="Project"
          >
            <div class="h-6 w-6 rotate-45 bg-slate-400"></div>
          </a>
        </li>

        <li class="w-full">
          <a
            href="#SocialMediaPage"
            class="flex w-full justify-center py-3 hover:bg-white/10"
            title="Social Media"
          >
            <div class="h-6 w-6 border-2 border-slate-400"></div>
          </a>
        </li>

        <li class="w-full">
          <a
            href="#ContactPage"
            class="flex w-full justify-center py-3 hover:bg-white/10"
            title="Contact"
          >
            <div
              class="h-6 w-6 bg-slate-400 [clip-path:polygon(50%_0%,100%_100%,0%_100%)]"
            ></div>
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  function autoScaleNavigation() {
    const stage = document.getElementById("nav-stage");
    if (!stage) return;

    const baseWidth = 1920;
    const baseHeight = 1080;

    const scaleX = window.innerWidth / baseWidth;
    const scaleY = window.innerHeight / baseHeight;
    const scale = Math.min(scaleX, scaleY);

    stage.style.transform = `scale(${scale})`;
  }

  autoScaleNavigation();
  window.addEventListener("resize", autoScaleNavigation);
</script>