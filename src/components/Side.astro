        <!-- ==================== CONTACT ==================== -->
        <li class="nav-item w-auto flex-1 lg:w-full">
          <a
            href="/#SocialMediaPage"
            class="nav-link flex flex-col items-center justify-center py-2 text-slate-400 transition-colors hover:bg-white/10 hover:text-white lg:flex-row lg:py-4 lg:pl-[28px] lg:justify-start lg:w-full"
            title="Contact"
          >
            <div
              class="icon-container flex h-6 w-6 shrink-0 items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M16 2v2"></path>

                <path
                  d="M7 21v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"
                ></path>

                <path d="M8 2v2"></path>

                <circle cx="12" cy="10" r="3"></circle>

                <rect
                  x="3"
                  y="3"
                  width="18"
                  height="18"
                  rx="2"
                ></rect>
              </svg>
            </div>

            <span
              class="nav-label hidden whitespace-nowrap text-sm font-bold uppercase tracking-wider lg:block lg:ml-5"
            >
              Contact
            </span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  import { gsap } from "../Script/gsap-utils";

  function autoScaleNavigation() {
    const stage = document.getElementById("nav-stage");

    if (!stage) return;

    if (window.innerWidth < 1024) {
      stage.style.transform = "";
      return;
    }

    const baseWidth = 1920;
    const baseHeight = 1080;

    const scaleX = window.innerWidth / baseWidth;
    const scaleY = window.innerHeight / baseHeight;

    const scale = scaleY;

    stage.style.transform = `scale(${scale})`;
  }

  function initSidebarExpansion() {
const sidebar = document.querySelector("#sidebar");
const logo = document.querySelector(".nav-logo");
const logoImage = document.querySelector(".nav-logo-image");
const logoText = document.querySelector(".nav-logo-text");
const labels = document.querySelectorAll(".nav-label");
const links = document.querySelectorAll(".nav-link");
    if (!sidebar) return;

    let mm = gsap.matchMedia();

    mm.add("(min-width: 1024px)", () => {
      // ==========================================
      // INITIAL STATE
      // ==========================================

      // Navigation labels invisible
      gsap.set(labels, {
        autoAlpha: 0,
        x: -15,
      });

      // Logo text invisible
      if (logoText) {
        gsap.set(logoText, {
          autoAlpha: 0,
          x: -15,
        });
      }

// ==========================================
// INITIAL LOGO STATE
// ==========================================

if (logo) {
  gsap.set(logo, {
    width: "100%",
    x: 0,
  });
}

if (logoImage) {
  gsap.set(logoImage, {
    scale: 1,
    transformOrigin: "center center",
  });
}

      // ==========================================
      // SIDEBAR EXPANSION TIMELINE
      // ==========================================
const sidebarTl = gsap
  .timeline({
    paused: true,
  })

  // ==========================================
  // SIDEBAR
  // ==========================================

  .to(
    sidebar,
    {
      width: 260,
      duration: 0.45,
      ease: "power3.inOut",
    },
    0
  )

  // ==========================================
  // LOGO
  // 40px → kira-kira 72px
  // TAPI POSISI TETAP DI TENGAH
  // ==========================================

  .to(
    logoImage,
    {
      scale: 1.8,
      duration: 0.45,
      ease: "power3.inOut",
    },
    0
  )

  // ==========================================
  // LOGO TEXT
  // ==========================================

  .to(
    logoText,
    {
      autoAlpha: 1,
      x: 0,
      duration: 0.3,
      ease: "power2.out",
    },
    "-=0.20"
  )

  // ==========================================
  // NAV LABELS
  // ==========================================

  .to(
    labels,
    {
      autoAlpha: 1,
      x: 0,
      duration: 0.3,
      stagger: 0.03,
      ease: "power2.out",
    },
    "-=0.20"
  );
      // ==========================================
      // SIDEBAR HOVER
      // ==========================================

      const onEnter = () => {
        sidebarTl.play();
      };

      const onLeave = () => {
        sidebarTl.reverse();
      };

      // ==========================================
      // ICON HOVER
      // ==========================================

      const onLinkEnter = (e) =>
        gsap.to(
          e.currentTarget.querySelector(".icon-container"),
          {
            scale: 1.15,
            duration: 0.3,
            ease: "back.out(2)",
          }
        );

      const onLinkLeave = (e) =>
        gsap.to(
          e.currentTarget.querySelector(".icon-container"),
          {
            scale: 1,
            duration: 0.3,
            ease: "power2.out",
          }
        );

      // ==========================================
      // EVENT LISTENERS
      // ==========================================

      sidebar.addEventListener("mouseenter", onEnter);

      sidebar.addEventListener("mouseleave", onLeave);

      links.forEach((link) => {
        link.addEventListener("mouseenter", onLinkEnter);

        link.addEventListener("mouseleave", onLinkLeave);
      });

      // ==========================================
      // CLEANUP
      // ==========================================

      return () => {
        sidebar.removeEventListener("mouseenter", onEnter);

        sidebar.removeEventListener("mouseleave", onLeave);

        links.forEach((link) => {
          link.removeEventListener(
            "mouseenter",
            onLinkEnter
          );

          link.removeEventListener(
            "mouseleave",
            onLinkLeave
          );
        });
gsap.set(
  [
    sidebar,
    logo,
    logoImage,
    logoText,
    labels,
  ],
  {
    clearProps: "all",
  }
);
      };
    });
  }

  // ==========================================
  // INITIALIZE
  // ==========================================

  autoScaleNavigation();

  initSidebarExpansion();

  window.addEventListener(
    "resize",
    autoScaleNavigation
  );
</script>