---
import "../styles/global.css";
---

<!-- Ubah letak pembungkus agar nempel di bawah (bottom) saat mode mobile -->
<nav
  id="side-nav"
  class="fixed inset-x-0 bottom-0 z-50 pointer-events-none lg:left-0 lg:top-0 lg:h-screen lg:w-screen lg:overflow-hidden"
>
  <!-- Stage: Tinggi/lebar statis dimatikan di mobile, kembali jadi absolute 1920x1080 di desktop -->
  <div
    id="nav-stage"
    class="relative h-auto w-full pointer-events-none lg:absolute lg:left-0 lg:top-0 lg:h-[1080px] lg:w-[1920px] lg:origin-top-left"
  >
    <!-- Sidebar / Bottom Bar -->
    <div
      id="sidebar"
      class="pointer-events-auto flex w-full flex-row items-center justify-around border-t border-slate-800 bg-black/95 px-2 py-2 backdrop-blur-md lg:absolute lg:left-0 lg:top-0 lg:h-[1080px] lg:w-[80px] lg:flex-col lg:items-start lg:border-r lg:border-t-0 lg:px-0 lg:py-6 lg:overflow-hidden"
    >
      <!-- ==================== LOGO ==================== -->
<!-- ==================== LOGO ==================== -->
<a
  href="/#WelcomePage"
  class="nav-logo hidden lg:mb-12 lg:flex lg:h-auto lg:w-full lg:shrink-0 lg:flex-col lg:items-center lg:justify-center"
>
  <img
    src="/RuckyLogo.svg"
    alt="Rucky Logo"
    class="nav-logo-image h-10 w-10 object-contain"
  />

<p
  class="nav-logo-text mt-7 whitespace-nowrap text-sm font-bold text-white"
>
  RuckyTheGreat
</p>
</a>
      <!-- Navigation List -->
      <ul
        class="flex w-full flex-row items-center justify-between gap-1 lg:flex-col lg:items-start lg:gap-2"
      >
        <!-- ==================== BIODATA ==================== -->
