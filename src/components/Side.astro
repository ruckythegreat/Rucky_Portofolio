              Biodata
            </span>
          </a>
        </li>

        <!-- ==================== HISTORY ==================== -->
        <li class="nav-item w-auto flex-1 lg:w-full">
          <a
            href="/#EducationHistoryPage"
            class="nav-link flex flex-col items-center justify-center py-2 text-slate-400 transition-colors hover:bg-white/10 hover:text-white lg:flex-row lg:py-4 lg:pl-[28px] lg:justify-start lg:w-full"
            title="Education"
          >
            <div
              class="icon-container flex h-6 w-6 shrink-0 items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect
                  width="18"
