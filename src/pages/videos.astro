---
import Layout from "../layouts/Layout.astro";
import Side from "../components/Side.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
---

<Side />

<Layout title="More Videos">
  <main class="relative min-h-screen w-full bg-black text-white lg:pl-[100px]">
    
    <section class="relative h-[300px] w-full lg:h-[400px]">
      <img 
        src="https://images.unsplash.com/photo-1485846234645-a62644f84728?q=80&w=2059&auto=format&fit=crop" 
        alt="Video Banner" 
        class="h-full w-full object-cover opacity-50"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
      <div class="absolute bottom-10 left-6 lg:left-12">
        <h1 class="text-4xl font-extrabold tracking-wider text-white lg:text-6xl">EXPLORE <span class="text-[#FF7873]">MEDIA</span></h1>
        <p class="mt-2 max-w-xl text-gray-300 lg:text-lg">Kumpulan dokumentasi, film pendek, dan profil kegiatan sekolah.</p>
      </div>
    </section>

    <section class="px-6 py-8 lg:px-12">
      <div id="filter-container" class="flex flex-wrap gap-3 border-b border-white/10 pb-4">
        </div>
    </section>

    <section class="px-6 pb-12 lg:px-12">
      <div id="video-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        </div>

      <div id="pagination-container" class="mt-12 flex items-center justify-center space-x-2">
        </div>
    </section>

    <Footer />
  </main>

  {/* MODAL (Ditambahkan ID 'modal-wrapper' untuk ukuran dinamis) */}
  <div id="video-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-sm">
    <button id="close-modal" class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center bg-white/10 text-white hover:bg-white/20 lg:right-6 lg:top-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18" /><path d="m6 6 12 12" />
      </svg>
    </button>
    <div id="modal-wrapper" class="w-full max-w-5xl px-4 aspect-video transition-all duration-300">
      <iframe id="modal-iframe" class="h-full w-full rounded-lg shadow-2xl bg-[#111]" src="" allow="autoplay; encrypted-media; fullscreen" allowfullscreen frameborder="0"></iframe>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // === DATA DUMMY VIDEO (Digabung dengan IG & TikTok) ===
    const rawVideos = [
      // Data YouTube Lama

      { category: "Ucapan", date: "2026-08-25", title: "Happy Birthday SMKN 2 Bandung from RPL (Minecraft Edition)", desc: "Ucapan Ulang tahun dan juga open house SMKN 2 dari RPL", type: "youtube", mediaId: "WAAEZzLE-nQ" },
      { category: "TikTok", date: "2025-10-22", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7563950930966727954" },
      { category: "Instagram", date: "2025-07-02", title: "Instagram Post @naptuneeel", desc: "Postingan media Instagram dari akun @naptuneeel", type: "instagram", mediaId: "DLmxMGCPoMlaW5FDhyZtyMZCuN38vKJiEtp_nU0" },
      { category: "TikTok", date: "2025-06-16", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7516563138003700999" },
      { category: "TikTok", date: "2025-06-05", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7512389312193858834" },
      { category: "Instagram", date: "2024-12-16", title: "Instagram Post @naptuneeel", desc: "Postingan media Instagram dari akun @naptuneeel", type: "instagram", mediaId: "DDq9QJjvaq_u7QgafFQUSa2fCT5ZBrwe9z5EaE0" },
      { category: "TikTok", date: "2024-12-13", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7447688845388270866" },
      { category: "TikTok", date: "2024-12-12", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7447363285629930759" },
      { category: "TikTok", date: "2024-12-06", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7445337305654562066" },
      { category: "TikTok", date: "2023-09-23", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7282004747773594886" },
      { category: "TikTok", date: "2023-09-12", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7277770319064993029" },
      { category: "Motion Graphics", date: "2023-09-07", title: "First Mograph #Shiroko", desc: "Eksperimen pertama membuat animasi motion graphics untuk karakter Shiroko.", type: "youtube", mediaId: "_6dhlWfs1gs" },
      { category: "Minecraft", date: "2023-08-17", title: "AUGUST 17th IS THE DAY INDONESIAN INDEPENDEN 🔥", desc: "Merayakan Hari Kemerdekaan Indonesia dengan membangun Monas (Monumen Nasional) Jakarta di Minecraft.", type: "youtube", mediaId: "w5nbenCaAak" },
      { category: "Gaming", date: "2023-07-01", title: "DIMAS SIGMA VS INTRUDERS @Greyzon Ch. :v", desc: "Gameplay seru dan kocak saat Dimas Sigma bermain game horor Roblox Intruders.", type: "youtube", mediaId: "jhlx7CK4IJQ" },
      { category: "TikTok", date: "2023-05-27", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7237778359030271237" },
      { category: "TikTok", date: "2023-05-14", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7233007196630437146" },
      { category: "TikTok", date: "2023-05-12", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7232318285084216602" },
      { category: "TikTok", date: "2023-05-06", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7229960977687530778" },
      { category: "TikTok", date: "2023-04-23", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7225138172865383686" },
      { category: "TikTok", date: "2023-04-20", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7224151841850821894" },
      { category: "TikTok", date: "2023-04-17", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7222886262053539099" },
      { category: "TikTok", date: "2023-04-13", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7221315111653231899" },
      { category: "TikTok", date: "2023-04-10", title: "TikTok Video @naptuneeel", desc: "Konten video TikTok dari akun @naptuneeel", type: "tiktok", mediaId: "7220386671345274139" }
    ];

    // Urutkan otomatis dari terbaru ke terlama
    const allVideos = rawVideos.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

    // === HELPER FUNCTIONS UNTUK EMBED DAN THUMBNAIL ===
    const getThumbnail = (media: any) => {
      if (media.type === "youtube") return `https://img.youtube.com/vi/${media.mediaId}/maxresdefault.jpg`;
      if (media.type === "tiktok") return "https://placehold.co/600x400/111111/FFFFFF/png?text=TikTok+Preview";
      if (media.type === "instagram") return "https://placehold.co/600x400/e1306c/FFFFFF/png?text=Instagram+Preview";
      return "";
    };

    const getWatchEmbed = (media: any) => {
      if (media.type === "youtube") return `https://www.youtube.com/embed/${media.mediaId}?autoplay=1&mute=0&rel=0&modestbranding=1`;
      if (media.type === "tiktok") return `https://www.tiktok.com/embed/v2/${media.mediaId}`;
      if (media.type === "instagram") return `https://www.instagram.com/p/${media.mediaId}/embed/`;
      return "";
    };

    // === STATE PAGINATION & FILTER ===
    const ITEMS_PER_PAGE = 8;
    let currentPage = 1;
    let currentCategory = "All";
    let filteredVideos = [...allVideos];

    // DOM Elements
    const gridContainer = document.getElementById("video-grid");
    const filterContainer = document.getElementById("filter-container");
    const paginationContainer = document.getElementById("pagination-container");
    const modal = document.getElementById("video-modal");
    const modalWrapper = document.getElementById("modal-wrapper");
    const iframe = document.getElementById("modal-iframe") as HTMLIFrameElement;
    const closeModalBtn = document.getElementById("close-modal");

    // === RENDER FILTER BUTTONS ===
    function renderFilters() {
      const categories = ["All", ...new Set(allVideos.map(v => v.category))];
      
      filterContainer!.innerHTML = categories.map(cat => `
        <button 
          class="filter-btn rounded-full border border-white/20 px-5 py-2 text-sm font-medium transition-colors ${cat === currentCategory ? 'bg-[#FF7873] text-black border-[#FF7873]' : 'bg-transparent text-gray-300 hover:bg-white/10'}"
          data-category="${cat}"
        >
          ${cat}
        </button>
      `).join("");

      document.querySelectorAll(".filter-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget as HTMLElement;
          currentCategory = target.dataset.category || "All";
          currentPage = 1; 
          
          if (currentCategory === "All") {
            filteredVideos = [...allVideos];
          } else {
            filteredVideos = allVideos.filter(v => v.category === currentCategory);
          }
          
          renderFilters(); 
          renderGrid();
        });
      });
    }

    // === RENDER GRID VIDEO ===
    function renderGrid() {
      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = startIndex + ITEMS_PER_PAGE;
      const videosToShow = filteredVideos.slice(startIndex, endIndex);

      if (videosToShow.length === 0) {
        gridContainer!.innerHTML = `<p class="col-span-1 sm:col-span-2 lg:col-span-4 py-10 text-center text-gray-400">Tidak ada video di kategori ini.</p>`;
      } else {
        gridContainer!.innerHTML = videosToShow.map((v, index) => {
          const actualIndex = startIndex + index;
          return `
          <div class="video-card group flex cursor-pointer flex-col overflow-hidden rounded-xl bg-white/5 border border-white/10 transition-transform duration-300 hover:-translate-y-1 hover:border-[#FF7873]/50 hover:shadow-[0_10px_30px_rgba(255,120,115,0.15)]" data-index="${actualIndex}">
            <div class="relative aspect-video w-full overflow-hidden bg-[#111]">
              <img src="${getThumbnail(v)}" alt="${v.title}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              
              <div class="absolute inset-0 z-10 flex items-center justify-center bg-black/40 opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#FF7873] shadow-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="black"><polygon points="6 3 20 12 6 21 6 3"/></svg>
                </div>
              </div>
              
              <span class="absolute left-2 top-2 z-20 rounded bg-black/80 px-2 py-1 text-[9px] font-bold uppercase tracking-widest text-[#FF7873]">${v.category}</span>
            </div>
            
            <div class="flex flex-1 flex-col p-4">
              <h3 class="mb-1.5 line-clamp-2 text-base font-bold leading-snug text-white group-hover:text-[#FF7873] transition-colors">${v.title}</h3>
              <p class="line-clamp-2 text-xs text-gray-400">${v.desc}</p>
            </div>
          </div>
        `}).join("");

        // Attach event listener ke setiap card untuk buka modal
        document.querySelectorAll(".video-card").forEach(card => {
          card.addEventListener("click", (e) => {
            const idx = parseInt((e.currentTarget as HTMLElement).dataset.index!);
            openModal(filteredVideos[idx]);
          });
        });
      }

      renderPagination();
    }

    // === RENDER PAGINATION ===
    function renderPagination() {
      const totalPages = Math.ceil(filteredVideos.length / ITEMS_PER_PAGE);
      let html = "";

      if (totalPages > 1) {
        html += `
          <button id="btn-prev" class="flex h-10 w-10 items-center justify-center border border-white/20 bg-white/5 transition-colors hover:bg-white/20 disabled:opacity-30 disabled:hover:bg-white/5" ${currentPage === 1 ? 'disabled' : ''}>
             <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
        `;

        for (let i = 1; i <= totalPages; i++) {
          html += `
            <button class="page-num-btn h-10 w-10 border border-white/20 font-bold transition-colors ${currentPage === i ? 'bg-[#FF7873] text-black border-[#FF7873]' : 'bg-white/5 hover:bg-white/20'}" data-page="${i}">
              ${i}
            </button>
          `;
        }

        html += `
          <button id="btn-next" class="flex h-10 w-10 items-center justify-center border border-white/20 bg-white/5 transition-colors hover:bg-white/20 disabled:opacity-30 disabled:hover:bg-white/5" ${currentPage === totalPages ? 'disabled' : ''}>
             <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        `;
      }

      paginationContainer!.innerHTML = html;

      const btnPrev = document.getElementById("btn-prev");
      if (btnPrev) btnPrev.addEventListener("click", () => changePage(currentPage - 1));

      const btnNext = document.getElementById("btn-next");
      if (btnNext) btnNext.addEventListener("click", () => changePage(currentPage + 1));

      document.querySelectorAll(".page-num-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const page = parseInt((e.currentTarget as HTMLElement).dataset.page!);
          changePage(page);
        });
      });
    }

    function changePage(newPage: number) {
      const totalPages = Math.ceil(filteredVideos.length / ITEMS_PER_PAGE);
      if (newPage < 1 || newPage > totalPages) return;
      currentPage = newPage;
      renderGrid();
      
      document.getElementById("filter-container")?.scrollIntoView({ behavior: 'smooth' });
    }

    // === FUNGSI MODAL VIDEO DINAMIS ===
    function openModal(media: any) {
      iframe.src = getWatchEmbed(media);

      // Ubah layout modal tergantung sumber video (Vertikal vs Horizontal)
      if (media.type === "youtube") {
        modalWrapper!.className = "w-full max-w-5xl px-4 aspect-video transition-all duration-300";
      } else {
        // Mode Smartphone untuk Tiktok & Instagram
        modalWrapper!.className = "w-full max-w-[400px] h-[85vh] px-4 transition-all duration-300";
      }

      modal?.classList.remove("hidden");
      modal?.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      iframe.src = "";
      modal?.classList.add("hidden");
      modal?.classList.remove("flex");
      document.body.style.overflow = "";
    }

    closeModalBtn?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal?.classList.contains("hidden")) closeModal();
    });

    // === INISIALISASI AWAL ===
    renderFilters();
    renderGrid();
  });
</script>